<div class="analytics-page">
  <%# ---- Page header ---- %>
  <div class="analytics-header d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
      <h1>Student Analysis</h1>
      <p>Inspect student-level academic performance and subject outcomes.</p>
    </div>
    <span id="analytics-mode-badge" class="analytics-mode-badge is-original" aria-live="polite">
      <span class="material-icons" aria-hidden="true">insights</span>
      Result Basis: <strong id="analytics-mode-label">Original</strong>
    </span>
  </div>

  <%# ---- Filters (options populated by Phase 5) ---- %>
  <div class="analytics-filters">
    <form id="analytics-filter-form" autocomplete="off">
      <div class="row g-3">
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-academic-year">Academic Year</label>
          <select class="form-select" id="filter-academic-year" name="exam_year">
            <option value="">All Academic Years</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-semester">Semester</label>
          <select class="form-select" id="filter-semester" name="semester">
            <option value="">All Semesters</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-department">Department</label>
          <select class="form-select" id="filter-department" name="department_id">
            <option value="">All Departments</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-batch">Batch</label>
          <select class="form-select" id="filter-batch" name="batch_id">
            <option value="">All Batches</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-session">Result Session</label>
          <select class="form-select" id="filter-session" name="session_id">
            <option value="">All Sessions</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-usn">Student / USN Search</label>
          <input type="text" class="form-control" id="filter-usn" name="usn" placeholder="USN or name">
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-attempt">Attempt</label>
          <select class="form-select" id="filter-attempt" name="attempt">
            <option value="latest" selected>Latest</option>
            <option value="all">All Attempts</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-mode">Mode</label>
          <select class="form-select" id="filter-mode" name="mode">
            <option value="original" selected>Original</option>
            <option value="effective">Effective</option>
          </select>
        </div>
        <div class="col-12 filter-actions">
          <button type="reset" class="btn btn-outline-secondary">Reset</button>
          <button type="submit" class="btn btn-primary">Apply Filters</button>
        </div>
      </div>
    </form>
  </div>

  <%# ---- Student analytics table ---- %>
  <section aria-labelledby="students-table-heading" class="mt-4">
    <div class="analytics-card">
      <h2 id="students-table-heading" class="h6 analytics-card-title">Student Performance</h2>
      <div class="table-responsive">
        <table class="table analytics-table" id="students-table">
          <caption class="visually-hidden">Student performance records</caption>
          <thead>
            <tr>
              <th scope="col">USN</th>
              <th scope="col">Student Name</th>
              <th scope="col">Semester</th>
              <th scope="col">Attempt</th>
              <th scope="col">Exam Type</th>
              <th scope="col">Subjects</th>
              <th scope="col">Passed</th>
              <th scope="col">Failed</th>
              <th scope="col">SGPA</th>
              <th scope="col">CGPA</th>
              <th scope="col">Result Status</th>
            </tr>
          </thead>
          <tbody id="students-table-body">
            <tr class="analytics-table-empty-row">
              <td colspan="11" class="analytics-table-empty">Select filters and apply them to view analytics.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%# ---- Pagination controls (wired by Phase 5) ---- %>
  <nav id="analytics-pagination" class="analytics-pagination" aria-label="Student results pagination">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="students-page-prev" disabled>Previous</button>
    <span id="students-page-indicator" class="analytics-page-indicator" aria-live="polite">Page &mdash;</span>
    <button type="button" class="btn btn-outline-secondary btn-sm" id="students-page-next" disabled>Next</button>
  </nav>

  <div id="analytics-empty-state" class="analytics-empty d-none" role="status">
    <span class="material-icons analytics-empty-icon" aria-hidden="true">inbox</span>
    <p>No analytics data found for the selected filters.</p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/js/analytics/page.js"></script>
<script src="/js/analytics/students.js"></script>
