<div class="analytics-page">
  <%# ---- Page header ---- %>
  <div class="analytics-header d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
      <h1>Toppers</h1>
      <p>Review student performance metrics across the selected academic scope.</p>
    </div>
    <span id="analytics-mode-badge" class="analytics-mode-badge is-original" aria-live="polite">
      <span class="material-icons" aria-hidden="true">insights</span>
      Result Basis: <strong id="analytics-mode-label">Original</strong>
    </span>
  </div>

  <%# ---- Filters (options populated by Phase 5) ---- %>
  <div class="analytics-filters">
    <form id="analytics-filter-form" autocomplete="off">
      <div class="row g-3">
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-batch">Batch</label>
          <%# Batch has no "All" option: JS lists batches newest-first and selects the latest. %>
          <select class="form-select" id="filter-batch" name="batch_id"></select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-semester">Semester</label>
          <select class="form-select" id="filter-semester" name="semester">
            <option value="">All Semesters</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-session">Result Session</label>
          <select class="form-select" id="filter-session" name="session_id">
            <option value="">All Sessions</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-attempt">Attempt</label>
          <select class="form-select" id="filter-attempt" name="attempt">
            <option value="latest" selected>Latest</option>
            <option value="all">All Attempts</option>
          </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
          <label class="form-label" for="filter-mode">Mode</label>
          <select class="form-select" id="filter-mode" name="mode">
            <option value="original" selected>Original</option>
            <option value="effective">Effective</option>
          </select>
        </div>
        <div class="col-12 filter-actions">
          <button type="reset" class="btn btn-outline-secondary">Reset</button>
          <button type="submit" class="btn btn-primary">Apply Filters</button>
        </div>
      </div>
    </form>
  </div>

  <%# ---- Candidate performance table (no ranking policy implied) ---- %>
  <section aria-labelledby="toppers-heading" class="mt-4">
    <div class="analytics-card">
      <h2 id="toppers-heading" class="h6 p-2 analytics-card-title">Student Performance Candidates</h2>
      <p class="analytics-note px-2 ">
        Only passed results with a stored CGPA are shown. Ranked by CGPA, highest first, numbered 1 to n.
      </p>
      <div class="analytics-toolbar">
        <label class="analytics-search-wrap" for="toppers-search">
          <span class="material-icons" aria-hidden="true">search</span>
          <input type="search" id="toppers-search" class="analytics-search"
                 placeholder="Search candidates…" autocomplete="off">
        </label>
        <span class="analytics-row-count" id="toppers-count" aria-live="polite"></span>
      </div>
      <div class="table-responsive">
        <table class="table analytics-table" id="toppers-table">
          <caption class="visually-hidden">Student performance candidate records</caption>
          <thead>
            <tr>
              <th scope="col" data-nosort>Rank</th>
              <th scope="col" data-nosort>USN</th>
              <th scope="col" data-nosort>Student Name</th>
              <th scope="col" data-nosort>Semester</th>
              <th scope="col" data-nosort>Attempt</th>
              <th scope="col" data-nosort>SGPA</th>
              <th scope="col" data-nosort>CGPA</th>
              <th scope="col" data-nosort>Result Status</th>
            </tr>
          </thead>
          <tbody id="toppers-table-body">
            <tr class="analytics-table-empty-row">
              <td colspan="8" class="analytics-table-empty">Select filters and apply them to view analytics.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%# ---- Pagination controls ---- %>
  <nav id="analytics-pagination" class="analytics-pagination" aria-label="Candidate results pagination">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="toppers-page-prev" disabled>Previous</button>
    <span id="toppers-page-indicator" class="analytics-page-indicator" aria-live="polite">Page &mdash;</span>
    <button type="button" class="btn btn-outline-secondary btn-sm" id="toppers-page-next" disabled>Next</button>
  </nav>

  <div id="analytics-empty-state" class="analytics-empty d-none" role="status">
    <span class="material-icons analytics-empty-icon" aria-hidden="true">inbox</span>
    <p>No analytics data found for the selected filters.</p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/js/analytics/charts.js"></script>
<script src="/js/analytics/tabletools.js"></script>
<script src="/js/analytics/toppers.js"></script>
