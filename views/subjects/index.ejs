<div class="container-fluid batches-page subjects-page" data-subjects-page>
  <a class="btn btn-outline-secondary mb-3" href="/subjects/courses">Semester Courses</a>
  <div class="alert-container position-fixed top-0 end-0 p-3" id="subjectsToastContainer" aria-live="polite" aria-atomic="true"></div>
  <div class="dashboard-header subjects-header"><div><h4>Subjects Management</h4><p class="text-muted">Select a batch and session to manage its subjects</p></div><button type="button" class="btn btn-primary" id="createSubjectBtn" disabled><span class="material-icons btn-icon">add</span>Create Subject</button></div>
  <div class="card mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="subjectBatchSelect">Batch <span class="text-danger">*</span></label><select class="form-select" id="subjectBatchSelect" disabled><option value="">Loading batches...</option></select></div><div class="col-md-6"><label class="form-label" for="subjectSessionSelect">Session <span class="text-danger">*</span></label><select class="form-select" id="subjectSessionSelect" disabled><option value="">Select Batch first</option></select></div></div><div class="alert alert-danger d-none mt-3 mb-0" id="subjectSelectionError" role="alert"></div></div></div>
  <div id="subjectsDashboard" class="d-none">
    <div class="row g-4 mb-4"><div class="col-sm-6 col-xl"><div class="card stat-card stat-blue"><div class="card-body"><div class="stat-label">Total Subjects</div><div class="stat-value" id="subjectTotalCount">0</div></div></div></div><div class="col-sm-6 col-xl"><div class="card stat-card stat-green"><div class="card-body"><div class="stat-label">Theory Subjects</div><div class="stat-value" id="subjectTheoryCount">0</div></div></div></div><div class="col-sm-6 col-xl"><div class="card stat-card stat-amber"><div class="card-body"><div class="stat-label">Lab Subjects</div><div class="stat-value" id="subjectLabCount">0</div></div></div></div><div class="col-sm-6 col-xl"><div class="card stat-card stat-teal"><div class="card-body"><div class="stat-label">Total Credits</div><div class="stat-value" id="subjectCreditsCount">0</div></div></div></div></div>
    <div class="card mb-4"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><h5 class="card-title mb-0">Subjects</h5><div class="subjects-toolbar"><div class="input-group subjects-search"><span class="input-group-text"><span class="material-icons">search</span></span><input type="search" class="form-control" id="subjectSearch" placeholder="Search Subject"></div><select class="form-select" id="subjectTypeFilter" aria-label="Filter subject type"><option value="all">All</option><option value="theory">Theory</option><option value="lab">Lab</option></select></div></div><div class="card-body"><div class="table-responsive" id="subjectsTableWrap"><table class="table table-hover align-middle batches-table subjects-table mb-0"><thead class="table-light"><tr><th>#</th><th>Subject Code</th><th>Subject Name</th><th>Subject Type</th><th>Credits</th><th>Max Internal</th><th>Max External</th><th>Max Marks</th><th>Actions</th></tr></thead><tbody id="subjectsTableBody"></tbody></table></div><div class="subjects-empty text-center py-5 d-none" id="subjectsEmpty"><span class="material-icons subjects-empty-icon">menu_book</span><h6>No subjects found for this session.</h6><button class="btn btn-primary btn-sm mt-2" type="button" data-create-subject>+ Create Subject</button></div></div></div>
  </div>
  <div class="card d-none" id="subjectPrompt"><div class="card-body text-center py-5"><span class="material-icons subjects-empty-icon">school</span><h6>Select Batch → Session → Manage Subjects</h6><p class="text-muted mb-0">Subjects will load automatically after both selections.</p></div></div>

  <div class="modal fade batches-modal" id="subjectFormModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="subjectFormTitle">Create Subject</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><form id="subjectForm" novalidate><div class="modal-body"><div class="alert alert-danger d-none" id="subjectFormError"></div><div class="row g-3 mb-3"><div class="col-md-6"><label class="form-label">Batch</label><input class="form-control subject-readonly-field" id="subjectFormBatch" readonly></div><div class="col-md-6"><label class="form-label">Session</label><input class="form-control subject-readonly-field" id="subjectFormSession" readonly></div></div><input type="hidden" id="editSubjectId"><div class="row g-3" id="subjectFields"><div class="col-md-4"><label class="form-label" for="subjectCode">Subject Code *</label><input class="form-control" id="subjectCode" maxlength="20" required><div class="invalid-feedback">Subject code is required.</div></div><div class="col-md-8"><label class="form-label" for="subjectName">Subject Name *</label><input class="form-control" id="subjectName" maxlength="100" required><div class="invalid-feedback">Subject name is required.</div></div><div class="col-md-4"><label class="form-label" for="subjectType">Subject Type *</label><select class="form-select" id="subjectType" required><option value="theory">Theory</option><option value="lab">Lab</option></select></div><div class="col-md-2"><label class="form-label" for="subjectCredits">Credits *</label><input type="number" class="form-control" id="subjectCredits" min="0" max="100" required></div><div class="col-md-3"><label class="form-label" for="subjectInternal">Max Internal *</label><input type="number" class="form-control" id="subjectInternal" min="0" required></div><div class="col-md-3"><label class="form-label" for="subjectExternal">Max External *</label><input type="number" class="form-control" id="subjectExternal" min="0" required></div><div class="col-md-4"><label class="form-label" for="subjectMaxMarks">Max Marks *</label><input type="number" class="form-control" id="subjectMaxMarks" min="0" required><div class="invalid-feedback" id="subjectMarksFeedback">Enter valid marks.</div></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit" id="subjectSaveBtn">Review Changes</button></div></form></div></div></div>
  <div class="modal fade batches-modal" id="subjectConfirmModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="subjectConfirmTitle">Confirm Subject</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert alert-danger d-none" id="subjectConfirmError"></div><p id="subjectConfirmQuestion"></p><div id="subjectConfirmSummary" class="batch-confirm-summary"></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="button" id="subjectConfirmBtn">Confirm &amp; Save</button></div></div></div></div>
  <div class="modal fade batches-modal" id="subjectDeleteModal" tabindex="-1" aria-hidden="true" aria-labelledby="subjectDeleteTitle"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="subjectDeleteTitle">Confirm Delete Subject</h5><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-danger d-none" id="subjectDeleteError"></div><p class="mb-3">Are you sure you want to delete this subject?</p><div id="subjectDeleteSummary" class="batch-confirm-summary"></div><p class="subject-delete-warning mt-3 mb-0">This action cannot be undone.</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" type="button" id="subjectDeleteBtn">Delete Subject</button></div></div></div></div>
  <script src="/js/subjects.js"></script>
</div>
