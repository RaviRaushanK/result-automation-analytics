<div class="container-fluid batches-page faculty-page" data-faculty-page>
  <div class="alert-container position-fixed top-0 end-0 p-3" id="facultyToastContainer" aria-live="polite" aria-atomic="true"></div>
  <div class="dashboard-header faculty-header"><div><h4>Faculty Assignments</h4><p class="text-muted">Assign up to two faculty members to each subject</p></div><div class="d-flex gap-2"><button type="button" class="btn btn-outline-primary" id="addFacultyBtn"><span class="material-icons btn-icon">person_add</span>Add Faculty</button><button type="button" class="btn btn-primary" id="saveFacultyAssignmentsBtn" disabled><span class="material-icons btn-icon">save</span>Save Faculty Assignments</button></div></div>
  <div class="card mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="facultyBatchSelect">Batch <span class="text-danger">*</span></label><select class="form-select" id="facultyBatchSelect" disabled><option value="">Loading batches...</option></select></div><div class="col-md-6"><label class="form-label" for="facultySessionSelect">Session <span class="text-danger">*</span></label><select class="form-select" id="facultySessionSelect" disabled><option value="">Select Batch first</option></select></div></div><div class="alert alert-danger d-none mt-3 mb-0" id="facultySelectionError"></div></div></div>
  <div id="facultyDashboard" class="d-none">
    <div class="row g-4 mb-4"><div class="col-sm-6 col-xl-3"><div class="card stat-card stat-blue"><div class="card-body"><div class="stat-label">Total Subjects</div><div class="stat-value" id="facultyTotalSubjects">0</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card stat-card stat-green"><div class="card-body"><div class="stat-label">Assigned Subjects</div><div class="stat-value" id="facultyAssignedSubjects">0</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card stat-card stat-amber"><div class="card-body"><div class="stat-label">Unassigned Subjects</div><div class="stat-value" id="facultyUnassignedSubjects">0</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card stat-card stat-teal"><div class="card-body"><div class="stat-label">Subjects With 2 Faculty</div><div class="stat-value" id="facultyTwoSubjects">0</div></div></div></div></div>
    <div class="card"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><h5 class="card-title mb-0" id="facultySubjectsTitle">Subjects</h5><div class="faculty-toolbar"><div class="input-group faculty-search"><span class="input-group-text"><span class="material-icons">search</span></span><input type="search" class="form-control" id="facultySearch" placeholder="Search Subject or Faculty"></div></div></div><div class="card-body"><div class="table-responsive"><table class="table table-hover align-middle batches-table faculty-table mb-0"><thead class="table-light"><tr><th>Subject Code</th><th>Subject</th><th>Faculty 1</th><th>Faculty 2</th><th>Actions</th></tr></thead><tbody id="facultyTableBody"></tbody></table></div><div class="text-center py-5 d-none" id="facultyEmpty"><span class="material-icons subjects-empty-icon">group_off</span><h6>No subjects found for this session.</h6><p class="text-muted mb-0">Create subjects before assigning faculty.</p></div></div></div>
  </div>
  <div class="card d-none" id="facultyPrompt"><div class="card-body text-center py-5"><span class="material-icons subjects-empty-icon">school</span><h6>Select Batch → Session → Assign Faculty</h6><p class="text-muted mb-0">Subjects will load automatically after both selections.</p></div></div>
  <div class="modal fade batches-modal" id="addFacultyModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Add Faculty</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><form id="addFacultyForm" novalidate><div class="modal-body"><div class="alert alert-danger d-none" id="addFacultyError"></div><div class="row g-3"><div class="col-md-6"><label class="form-label" for="facultyDepartment">Department *</label><select class="form-select" id="facultyDepartment" required><option value="">Select Department</option></select></div><div class="col-md-6"><label class="form-label" for="facultyCodeInput">Faculty Code *</label><input class="form-control" id="facultyCodeInput" maxlength="20" required></div><div class="col-md-6"><label class="form-label" for="facultyNameInput">Faculty Name *</label><input class="form-control" id="facultyNameInput" maxlength="100" required></div><div class="col-md-6"><label class="form-label" for="facultyEmailInput">Email</label><input type="email" class="form-control" id="facultyEmailInput" maxlength="100"></div><div class="col-md-6"><label class="form-label" for="facultyDesignationInput">Designation</label><input class="form-control" id="facultyDesignationInput" maxlength="100"></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Review Faculty</button></div></form></div></div></div>
  <div class="modal fade batches-modal" id="facultyConfirmModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="facultyConfirmTitle">Confirm Faculty Assignment</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert alert-danger d-none" id="facultyConfirmError"></div><p>Are you sure you want to save these faculty assignments?</p><div id="facultyConfirmSummary" class="faculty-confirm-list"></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="button" id="facultyConfirmSaveBtn">Confirm &amp; Save</button></div></div></div></div>
  <div class="modal fade batches-modal" id="facultyRemoveModal" tabindex="-1" aria-hidden="true" aria-labelledby="facultyRemoveTitle"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="facultyRemoveTitle">Confirm Remove Faculty Assignment</h5><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-danger d-none" id="facultyRemoveError"></div><div id="facultyRemoveSummary" class="faculty-confirm-list"></div><p class="mb-0 mt-3" id="facultyRemoveQuestion">Are you sure you want to remove this faculty assignment?</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" type="button" id="facultyRemoveBtn">Remove Assignment</button></div></div></div></div>
  <script src="/js/faculty.js"></script>
</div>
