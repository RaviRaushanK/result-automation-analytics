<div class="container-fluid batches-page sessions-page" data-sessions-page data-sessions='<%= JSON.stringify(sessions).replace(/'/g, "&#39;") %>' data-batches='<%= JSON.stringify(batches).replace(/'/g, "&#39;") %>'>
  <div class="alert-container position-fixed top-0 end-0 p-3" id="sessionsToastContainer" aria-live="polite" aria-atomic="true"></div>

  <div class="dashboard-header sessions-header">
    <div>
      <h4>Session Management</h4>
      <p class="text-muted">Create, manage and update academic sessions</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" id="createSessionHeaderBtn">
      <span class="material-icons btn-icon">add</span>Create New Session
    </button>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="card stat-card stat-blue"><span class="stat-corner"></span><div class="card-body"><div class="stat-icon"><span class="material-icons">event</span></div><div class="stat-content"><div class="stat-value" id="totalSessionsCount">0</div><div class="stat-label">Total Sessions</div></div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card stat-card stat-green"><span class="stat-corner"></span><div class="card-body"><div class="stat-icon"><span class="material-icons">check_circle</span></div><div class="stat-content"><div class="stat-value" id="completedSessionsCount">0</div><div class="stat-label">Completed</div></div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card stat-card stat-amber"><span class="stat-corner"></span><div class="card-body"><div class="stat-icon"><span class="material-icons">schedule</span></div><div class="stat-content"><div class="stat-value" id="upcomingSessionsCount">0</div><div class="stat-label">Upcoming</div></div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card stat-card stat-teal"><span class="stat-corner"></span><div class="card-body"><div class="stat-icon"><span class="material-icons">today</span></div><div class="stat-content"><div class="stat-value stat-batch-name" id="currentSessionName">—</div><div class="stat-label">Current Session</div></div></div></div></div>
  </div>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h5 class="card-title mb-0">All Sessions</h5>
      <div class="sessions-toolbar">
        <div class="input-group sessions-search"><span class="input-group-text"><span class="material-icons">search</span></span><input type="search" class="form-control" id="sessionSearch" placeholder="Search sessions..."></div>
        <select class="form-select" id="sessionStatusFilter" aria-label="Filter sessions by status"><option value="all">All Status</option><option value="completed">Completed</option><option value="active">Active</option><option value="upcoming">Upcoming</option></select>
        <select class="form-select" id="sessionBatchFilter" aria-label="Filter sessions by batch"><option value="all">All Batches</option><% batches.forEach(function(b){ %><option value="<%= b.batch_id %>"><%= b.batch_name %></option><% }); %></select>
      </div>
    </div>
    <div class="card-body">
      <div class="table-responsive" id="sessionsTableWrapper">
        <table class="table table-hover align-middle batches-table sessions-table mb-0" id="sessionsTable">
          <thead class="table-light"><tr><th>Session</th><th>Batch</th><th>Department</th><th>Semester</th><th>Starting Month</th><th>Exam Year</th><th>Status</th><th>Created Date</th><th class="text-center">Actions</th></tr></thead>
          <tbody id="sessionsTableBody"><tr><td colspan="9" class="text-center table-loading"><span class="spinner-border spinner-border-sm text-primary me-2"></span>Loading sessions...</td></tr></tbody>
        </table>
      </div>
      <div class="batches-empty-state sessions-empty-state d-none" id="sessionsEmptyState"><span class="material-icons batches-empty-icon">event_available</span><h6 class="batches-empty-title" id="sessionsEmptyTitle">No sessions found</h6><p class="batches-empty-text mb-0" id="sessionsEmptyText">Create your first academic session to get started.</p><button type="button" class="btn btn-primary mt-3" id="emptyStateCreateSessionBtn"><span class="material-icons btn-icon">add</span>Create New Session</button></div>
    </div>
  </div>

  <div class="modal fade batches-modal sessions-modal" id="createSessionModal" tabindex="-1" aria-labelledby="createSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="createSessionModalLabel">Create New Session</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <form id="createSessionForm" novalidate><div class="modal-body">
        <div class="alert alert-danger d-none" id="createSessionError" role="alert"></div>
        <div class="mb-3"><label for="createSessionBatch" class="form-label">Batch <span class="text-danger">*</span></label><select class="form-select" id="createSessionBatch" required><option value="">Select a batch</option><% batches.forEach(function(b){ %><option value="<%= b.batch_id %>"><%= b.batch_name %> — <%= b.Department ? b.Department.department_name : '' %></option><% }); %></select><div class="invalid-feedback">Please select a batch.</div></div>
        <div class="row g-3">
          <div class="col-md-6"><label for="createSessionSemester" class="form-label">Semester <span class="text-danger">*</span></label><input type="number" class="form-control" id="createSessionSemester" min="1" max="24" step="1" required><div class="invalid-feedback">Enter a semester from 1 to 24.</div></div>
          <div class="col-md-6"><label for="createSessionMonth" class="form-label">Starting Month <span class="text-danger">*</span></label><select class="form-select" id="createSessionMonth" required><option value="">Select month</option></select><div class="invalid-feedback">Select a starting month.</div></div>
          <div class="col-md-6"><label for="createSessionYear" class="form-label">Exam Year <span class="text-danger">*</span></label><input type="number" class="form-control" id="createSessionYear" min="1900" max="2200" step="1" required><div class="invalid-feedback">Enter a valid exam year.</div></div>
          <div class="col-md-6"><label for="createSessionStatus" class="form-label">Status</label><input type="text" class="form-control session-readonly-field" id="createSessionStatus" readonly value="Upcoming"></div>
        </div>
      </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" id="createSessionSubmitBtn"><span class="material-icons btn-icon">add</span><span class="btn-text">Create Session</span></button></div></form>
    </div></div>
  </div>

  <div class="modal fade batches-modal sessions-modal" id="confirmCreateSessionModal" tabindex="-1" aria-labelledby="confirmCreateSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="confirmCreateSessionModalLabel">Confirm New Session</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-danger d-none" id="confirmCreateSessionError" role="alert"></div><p>Are you sure you want to create this session?</p><div class="batch-confirm-summary" id="confirmCreateSessionSummary"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" id="confirmCreateSessionCancelBtn">Cancel</button><button type="button" class="btn btn-primary" id="confirmCreateSessionBtn">Confirm &amp; Create</button></div></div></div>
  </div>

  <div class="modal fade batches-modal sessions-modal" id="editSessionModal" tabindex="-1" aria-labelledby="editSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="editSessionModalLabel">Edit Session</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <form id="editSessionForm" novalidate><div class="modal-body"><div class="alert alert-danger d-none" id="editSessionError" role="alert"></div><input type="hidden" id="editSessionId"><div class="mb-3"><label for="editSessionBatch" class="form-label">Batch</label><input type="text" class="form-control session-readonly-field" id="editSessionBatch" readonly><div class="form-text session-hint">The batch association cannot be changed.</div></div><div class="row g-3">
        <div class="col-md-6"><label for="editSessionSemester" class="form-label">Semester <span class="text-danger">*</span></label><input type="number" class="form-control" id="editSessionSemester" min="1" max="24" required><div class="invalid-feedback">Enter a semester from 1 to 24.</div></div>
        <div class="col-md-6"><label for="editSessionMonth" class="form-label">Starting Month <span class="text-danger">*</span></label><select class="form-select" id="editSessionMonth" required><option value="">Select month</option></select><div class="invalid-feedback">Select a starting month.</div></div>
        <div class="col-md-6"><label for="editSessionYear" class="form-label">Exam Year <span class="text-danger">*</span></label><input type="number" class="form-control" id="editSessionYear" min="1900" max="2200" required><div class="invalid-feedback">Enter a valid exam year.</div></div>
        <div class="col-md-6"><label for="editSessionStatus" class="form-label">Status</label><input type="text" class="form-control session-readonly-field" id="editSessionStatus" readonly></div>
      </div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" id="editSessionSubmitBtn"><span class="material-icons btn-icon">save</span><span class="btn-text">Save Changes</span></button></div></form>
    </div></div>
  </div>

  <div class="modal fade batches-modal sessions-modal" id="confirmEditSessionModal" tabindex="-1" aria-labelledby="confirmEditSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="confirmEditSessionModalLabel">Confirm Session Update</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-danger d-none" id="confirmEditSessionError" role="alert"></div><p>Are you sure you want to update this session?</p><div class="batch-confirm-summary" id="confirmEditSessionSummary"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" id="confirmEditSessionCancelBtn">Cancel</button><button type="button" class="btn btn-primary" id="confirmEditSessionBtn">Confirm &amp; Save</button></div></div></div>
  </div>

  <div class="modal fade batches-modal sessions-modal" id="sessionDetailsModal" tabindex="-1" aria-labelledby="sessionDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="sessionDetailsModalLabel">Session Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-danger d-none" id="sessionDetailsError" role="alert"></div><div class="text-center py-3" id="sessionDetailsLoading"><span class="spinner-border text-primary"></span><div class="mt-2 text-muted">Loading session details...</div></div><div class="batch-confirm-summary d-none" id="sessionDetailsList"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div></div></div>
  </div>

  <script src="/js/sessions.js"></script>

</div>
