<!-- ============================================
     Batch Sessions Management - SRAAS
     Academic Management → Batches → Sessions
============================================ -->
<div class="container-fluid batches-page sessions-page">
  <!-- Notification container (same design as the app's flash alert container) -->
  <div
    class="alert-container position-fixed top-0 end-0 p-3"
    id="sessionsToastContainer"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <!-- Page Header -->
  <div class="dashboard-header sessions-header">
    <div>
      <h4>Session Management</h4>
      <p class="text-muted">Manage semesters/sessions for this batch</p>
    </div>
    <a href="/batches" class="btn btn-outline-secondary btn-sm">
      <span class="material-icons btn-icon">arrow_back</span>Back to Batches
    </a>
  </div>

  <!-- Batch Information Card -->
  <div class="card batch-info-card mb-4">
    <div class="card-body">
      <div class="batch-info-head">
        <div class="batch-info-heading">
          <h5 class="batch-info-name" id="batchInfoName">
            <%= batch.batch_name %>
          </h5>
          <span class="batch-info-meta" id="batchInfoDepartment">
            <%= batch.Department ? batch.Department.department_name : '—' %>
          </span>
        </div>
        <span
          class="badge <%= batch.status === 'active' ? 'bg-success' : 'bg-warning text-dark' %>"
          id="batchInfoStatus"
          ><%= batch.status === 'active' ? 'Active' : 'Inactive' %></span
        >
      </div>
      <div class="batch-info-grid">
        <div class="batch-info-item">
          <span class="batch-info-label">Batch Duration</span>
          <span class="batch-info-value" id="batchInfoDuration"
            ><%= batch.start_year %> – <%= batch.end_year %></span
          >
        </div>
        <div class="batch-info-item">
          <span class="batch-info-label">Department</span>
          <span class="batch-info-value" id="batchInfoDepartmentName"
            ><%= batch.Department ? batch.Department.department_name : '—'
            %></span
          >
        </div>
        <div class="batch-info-item">
          <span class="batch-info-label">Total Sessions</span>
          <span class="batch-info-value" id="batchInfoSessionCount">—</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
      <!-- Total Sessions -->
      <div class="card stat-card stat-blue">
        <span class="stat-corner" aria-hidden="true"></span>
        <div class="card-body">
          <div class="stat-icon">
            <span class="material-icons">event</span>
          </div>
          <div class="stat-content">
            <div class="stat-value" id="totalSessionsCount">--</div>
            <div class="stat-label">Total Sessions</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <!-- Completed -->
      <div class="card stat-card stat-green">
        <span class="stat-corner" aria-hidden="true"></span>
        <div class="card-body">
          <div class="stat-icon">
            <span class="material-icons">check_circle</span>
          </div>
          <div class="stat-content">
            <div class="stat-value" id="completedSessionsCount">--</div>
            <div class="stat-label">Completed</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <!-- Upcoming -->
      <div class="card stat-card stat-amber">
        <span class="stat-corner" aria-hidden="true"></span>
        <div class="card-body">
          <div class="stat-icon">
            <span class="material-icons">schedule</span>
          </div>
          <div class="stat-content">
            <div class="stat-value" id="upcomingSessionsCount">--</div>
            <div class="stat-label">Upcoming</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <!-- Current Session -->
      <div class="card stat-card stat-teal">
        <span class="stat-corner" aria-hidden="true"></span>
        <div class="card-body">
          <div class="stat-icon">
            <span class="material-icons">today</span>
          </div>
          <div class="stat-content">
            <div class="stat-value stat-batch-name" id="currentSessionName">
              --
            </div>
            <div class="stat-label">Current Session</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Batch Sessions -->
  <div class="card mb-4">
    <div
      class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"
    >
      <h5 class="card-title mb-0">Batch Sessions</h5>
      <button
        type="button"
        class="btn btn-primary btn-sm"
        id="createSessionHeaderBtn"
      >
        <span class="material-icons btn-icon">add</span>Create Session
      </button>
    </div>
    <div class="card-body">
      <!-- Semester sequence tracker -->
      <div class="session-sequence mb-3">
        <div class="session-sequence-title">Existing Sessions</div>
        <div class="session-sequence-list" id="sessionSequence"></div>
      </div>

      <!-- Sessions Table -->
      <div class="table-responsive" id="sessionsTableWrapper">
        <table
          class="table table-hover align-middle batches-table sessions-table mb-0"
          id="sessionsTable"
        >
          <thead class="table-light">
            <tr>
              <th scope="col">Semester</th>
              <th scope="col">Starting Month</th>
              <th scope="col">Exam Year</th>
              <th scope="col">Status</th>
              <th scope="col">Created Date</th>
              <th scope="col" class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody id="sessionsTableBody">
            <tr>
              <td colspan="6" class="text-center table-loading">
                <div
                  class="spinner-border spinner-border-sm text-primary"
                  role="status"
                >
                  <span class="visually-hidden">Loading...</span>
                </div>
                <span class="ms-2 text-muted">Loading sessions...</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div
        class="batches-empty-state sessions-empty-state d-none"
        id="sessionsEmptyState"
      >
        <span class="material-icons batches-empty-icon">event_available</span>
        <h6 class="batches-empty-title" id="sessionsEmptyTitle">
          No sessions created yet
        </h6>
        <p class="batches-empty-text mb-0" id="sessionsEmptyText">
          Create the first session for this batch to get started.
        </p>
        <button
          type="button"
          class="btn btn-primary mt-3"
          id="emptyStateCreateSessionBtn"
        >
          <span class="material-icons btn-icon">add</span>Create Session
        </button>
      </div>
    </div>
  </div>
  <!-- ============================
         Create New Session Modal
    ============================ -->
  <div
    class="modal fade batches-modal sessions-modal"
    id="createSessionModal"
    tabindex="-1"
    aria-labelledby="createSessionModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="createSessionModalLabel">
            Create New Session
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <form id="createSessionForm" novalidate>
          <div class="modal-body">
            <div
              class="alert alert-danger d-none"
              id="createSessionError"
              role="alert"
            ></div>
            <div class="row g-3">
              <div class="col-12">
                <label for="createSessionBatch" class="form-label">Batch</label>
                <input
                  type="text"
                  class="form-control session-readonly-field"
                  id="createSessionBatch"
                  value="<%= batch.batch_name %>"
                  readonly
                  tabindex="-1"
                />
              </div>
              <div class="col-md-6">
                <label for="createSessionSemester" class="form-label"
                  >Semester <span class="text-danger">*</span></label
                >
                <select
                  class="form-select"
                  id="createSessionSemester"
                  name="semester"
                >
                  <option value="">Select semester</option>
                </select>
                <div class="invalid-feedback">Semester is required.</div>
                <div class="form-text session-hint">
                  Existing semesters are disabled to prevent duplicates.
                </div>
              </div>
              <div class="col-md-6">
                <label for="createSessionMonth" class="form-label"
                  >Starting Month <span class="text-danger">*</span></label
                >
                <select
                  class="form-select"
                  id="createSessionMonth"
                  name="exam_session"
                >
                  <option value="">Select month</option>
                </select>
                <div class="invalid-feedback">Starting month is required.</div>
              </div>
              <div class="col-md-6">
                <label for="createSessionYear" class="form-label"
                  >Exam Year <span class="text-danger">*</span></label
                >
                <input
                  type="number"
                  class="form-control"
                  id="createSessionYear"
                  name="exam_year"
                  placeholder="2025"
                  min="1900"
                  max="2200"
                  step="1"
                />
                <div class="invalid-feedback">
                  Exam year must be a valid year.
                </div>
              </div>
              <div class="col-md-6">
                <label for="createSessionStatus" class="form-label"
                  >Status</label
                >
                <input
                  type="text"
                  class="form-control session-readonly-field"
                  id="createSessionStatus"
                  value=""
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                />
                <div class="form-text session-hint">
                  Derived automatically from the month and year.
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-outline-secondary"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary"
              id="createSessionSubmitBtn"
            >
              <span class="material-icons btn-icon">add</span
              ><span class="btn-text">Create Session</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <!-- ============================
         Confirm New Session Modal
    ============================ -->
  <div
    class="modal fade batches-modal sessions-modal"
    id="confirmCreateSessionModal"
    tabindex="-1"
    aria-labelledby="confirmCreateSessionModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmCreateSessionModalLabel">
            Confirm New Session
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div
            class="alert alert-danger d-none"
            id="confirmCreateSessionError"
            role="alert"
          ></div>
          <p class="mb-3">Are you sure you want to create this session?</p>
          <div class="batch-confirm-summary" id="confirmCreateSessionSummary">
            <div class="batch-summary-row">
              <span class="batch-summary-label">Batch</span
              ><span class="batch-summary-value" data-field="batch">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Semester</span
              ><span class="batch-summary-value" data-field="semester">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Starting Month</span
              ><span class="batch-summary-value" data-field="month">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Exam Year</span
              ><span class="batch-summary-value" data-field="exam_year">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Status</span
              ><span class="batch-summary-value" data-field="status">-</span>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-outline-secondary"
            id="confirmCreateSessionCancelBtn"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn btn-primary"
            id="confirmCreateSessionBtn"
          >
            Confirm &amp; Create
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- ============================
         Edit Session Modal
    ============================ -->
  <div
    class="modal fade batches-modal sessions-modal"
    id="editSessionModal"
    tabindex="-1"
    aria-labelledby="editSessionModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editSessionModalLabel">Edit Session</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <form id="editSessionForm" novalidate>
          <div class="modal-body">
            <div
              class="alert alert-danger d-none"
              id="editSessionError"
              role="alert"
            ></div>
            <input type="hidden" id="editSessionId" />
            <div class="row g-3">
              <div class="col-12">
                <label for="editSessionBatch" class="form-label">Batch</label>
                <input
                  type="text"
                  class="form-control session-readonly-field"
                  id="editSessionBatch"
                  value="<%= batch.batch_name %>"
                  readonly
                  tabindex="-1"
                />
                <div class="form-text session-hint">
                  The batch association cannot be changed.
                </div>
              </div>
              <div class="col-md-6">
                <label for="editSessionSemester" class="form-label"
                  >Semester <span class="text-danger">*</span></label
                >
                <select
                  class="form-select"
                  id="editSessionSemester"
                  name="semester"
                >
                  <option value="">Select semester</option>
                </select>
                <div class="invalid-feedback">Semester is required.</div>
              </div>
              <div class="col-md-6">
                <label for="editSessionMonth" class="form-label"
                  >Starting Month <span class="text-danger">*</span></label
                >
                <select
                  class="form-select"
                  id="editSessionMonth"
                  name="exam_session"
                >
                  <option value="">Select month</option>
                </select>
                <div class="invalid-feedback">Starting month is required.</div>
              </div>
              <div class="col-md-6">
                <label for="editSessionYear" class="form-label"
                  >Exam Year <span class="text-danger">*</span></label
                >
                <input
                  type="number"
                  class="form-control"
                  id="editSessionYear"
                  name="exam_year"
                  placeholder="2026"
                  min="1900"
                  max="2200"
                  step="1"
                />
                <div class="invalid-feedback">
                  Exam year must be a valid year.
                </div>
              </div>
              <div class="col-md-6">
                <label for="editSessionStatus" class="form-label">Status</label>
                <input
                  type="text"
                  class="form-control session-readonly-field"
                  id="editSessionStatus"
                  value=""
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                />
                <div class="form-text session-hint">
                  Derived automatically from the month and year.
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-outline-secondary"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary"
              id="editSessionSubmitBtn"
            >
              <span class="material-icons btn-icon">save</span
              ><span class="btn-text">Save Changes</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <!-- ============================
         Confirm Session Update Modal
    ============================ -->
  <div
    class="modal fade batches-modal sessions-modal"
    id="confirmEditSessionModal"
    tabindex="-1"
    aria-labelledby="confirmEditSessionModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmEditSessionModalLabel">
            Confirm Session Update
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div
            class="alert alert-danger d-none"
            id="confirmEditSessionError"
            role="alert"
          ></div>
          <p class="mb-3">Are you sure you want to update this session?</p>
          <div class="batch-confirm-summary" id="confirmEditSessionSummary">
            <div class="batch-summary-row">
              <span class="batch-summary-label">Batch</span
              ><span class="batch-summary-value" data-field="batch">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Semester</span
              ><span class="batch-summary-value" data-field="semester">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Starting Month</span
              ><span class="batch-summary-value" data-field="month">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Exam Year</span
              ><span class="batch-summary-value" data-field="exam_year">-</span>
            </div>
            <div class="batch-summary-row">
              <span class="batch-summary-label">Status</span
              ><span class="batch-summary-value" data-field="status">-</span>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-outline-secondary"
            id="confirmEditSessionCancelBtn"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn btn-primary"
            id="confirmEditSessionBtn"
          >
            Confirm &amp; Save
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- ============================
         Session Details Modal
    ============================ -->
  <div
    class="modal fade batches-modal sessions-modal"
    id="sessionDetailsModal"
    tabindex="-1"
    aria-labelledby="sessionDetailsModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="sessionDetailsModalLabel">
            Session Details
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div id="sessionDetailsLoading" class="text-center py-4">
            <div
              class="spinner-border spinner-border-sm text-primary"
              role="status"
            >
              <span class="visually-hidden">Loading...</span>
            </div>
            <span class="ms-2 text-muted">Loading session details...</span>
          </div>
          <div
            class="alert alert-danger d-none"
            id="sessionDetailsError"
            role="alert"
          ></div>
          <dl class="batch-details-list d-none mb-0" id="sessionDetailsList">
            <div class="batch-details-row">
              <dt>Session ID</dt>
              <dd data-field="session_id">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Session UUID</dt>
              <dd class="batch-details-uuid">
                <code data-field="session_uuid">-</code>
              </dd>
            </div>
            <div class="batch-details-row">
              <dt>Batch</dt>
              <dd data-field="batch">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Department</dt>
              <dd data-field="department">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Semester</dt>
              <dd data-field="semester">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Starting Month</dt>
              <dd data-field="month">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Exam Year</dt>
              <dd data-field="exam_year">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Status</dt>
              <dd data-field="status">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Created At</dt>
              <dd data-field="created_at">-</dd>
            </div>
            <div class="batch-details-row">
              <dt>Updated At</dt>
              <dd data-field="updated_at">-</dd>
            </div>
          </dl>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-outline-secondary"
            data-bs-dismiss="modal"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Server-rendered data consumed by sessions.js -->
<div
  id="sessionsPageData"
  data-batch="<%= JSON.stringify(batch) %>"
  data-sessions="<%= JSON.stringify(sessions || []) %>"
  class="d-none"
></div>

<script src="/js/sessions.js"></script>
