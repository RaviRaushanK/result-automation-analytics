<% const verifying = typeof otpStep !== 'undefined' && otpStep; %>
<section class="registration-page auth-page">
    <div class="registration-shell auth-shell">
        <%- include('partials/welcome-panel', { recovery: true }) %>
        <div class="registration-card auth-card">
        <form method="POST" action="/forgot-password" class="auth-form" id="forgotPasswordForm">
            <span class="registration-eyebrow">ACCOUNT RECOVERY</span>

            <h1>Forgot your password?</h1>
            <% if (verifying) { %><p class="auth-description">Enter the 6-digit code sent to <%= typeof maskedDestination !== 'undefined' && maskedDestination ? maskedDestination : 'your registered email address' %>.</p><% } else { %><p class="auth-description">Enter your registered email address. We’ll send a verification code to help you reset your password.</p><% } %>

            <% if (typeof notice !== 'undefined' && notice) { %>
            <div class="alert alert-success mt-3 w-100" role="status">
                <%= notice %>
            </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show mt-3 w-100" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <% if (verifying) { %>
            <input type="hidden" name="recoveryAction" value="verify">
            <input type="hidden" name="adminId" value="<%= adminId %>">
            <div class="mb-3"><label for="recovery-code">Email verification code</label><input class="form-control registration-code" id="recovery-code" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus></div>
            <button type="submit" class="login-btn">Verify code</button>
            <div class="mt-3"><button class="registration-send" type="button" id="recovery-resend" data-admin-id="<%= adminId %>" data-wait="<%= typeof resendInSeconds !== 'undefined' ? resendInSeconds : 60 %>">Resend code</button><p class="small mt-2" id="recovery-resend-status" role="status" aria-live="polite"></p></div>
            <% } else { %>
            <div class="mb-3">
                <label for="recovery-email">Registered email address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="material-icons">email</i></span>
                    <input type="email" id="recovery-email" name="email" class="form-control" placeholder="Enter your registered email" maxlength="100" required autofocus autocomplete="email">
                </div>
            </div>

            <button type="submit" class="login-btn" id="sendOtpBtn">
                <i class="material-icons me-1">email</i> Send Verification Code
            </button>
            <% } %>

            <p class="mt-3"><a href="/login" class="auth-back"><span class="material-icons" aria-hidden="true">arrow_back</span>Back to sign in</a></p>
        </form>
        <footer class="registration-footer">Need help? Contact your institution administrator.</footer>
        </div>
    </div>
</section>

<script>
    (function() {
        var form = document.getElementById('forgotPasswordForm');
        var btn = document.getElementById('sendOtpBtn');
        if (form && btn) {
            form.addEventListener('submit', function() {
                btn.classList.add('loading');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...';
            });
        }
    })();
</script>
<script src="/js/passwordRecovery.js" defer></script>
