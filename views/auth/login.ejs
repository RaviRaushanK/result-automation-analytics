<section class="registration-page auth-page">
    <div class="registration-shell auth-shell">
        <%- include('partials/welcome-panel', { recovery: false }) %>
        <div class="registration-card auth-card">
        <!-- Login Form -->
        <form method="POST" action="/login" class="auth-form" id="loginForm">
            <!-- Logo -->
            <span class="registration-eyebrow">WELCOME TO SRAAS</span>

            <!-- System Title -->
            <h1>Welcome back</h1>
            <p class="auth-description">Sign in to your institution account to continue.</p>

            <!-- Session Expired Message -->
            <% if (typeof passwordChanged !== 'undefined' && passwordChanged) { %><div class="alert alert-success" role="status">Your password has been updated. Sign in with your new password.</div><% } %>
            <% if (expired) { %>
            <div class="alert alert-warning alert-dismissible fade show mt-3 w-100" role="alert">
                Your session has expired. Please log in again.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <!-- Error Message -->
            <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show mt-3 w-100" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>
            <div class="mb-3">
                <label for="login-username">Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="material-icons">person</i></span>
                    <input type="text" id="login-username" name="username" class="form-control" placeholder="Enter your username" autocomplete="username" required autofocus>
                </div>
            </div>
            <div class="mb-3">
                <label for="passwordInput">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="material-icons">lock</i></span>
                    <input type="password" name="password" class="form-control" placeholder="Password" required id="passwordInput" autocomplete="current-password">
                    <button type="button" class="password-toggle-btn" id="togglePassword" aria-label="Toggle password visibility">
                        <i class="material-icons" id="toggleIcon">visibility</i>
                    </button>
                </div>
            </div>
            <div class="mb-3 form-check d-flex align-items-center">
                <input type="checkbox" name="remember" class="form-check-input me-2" id="rememberMe">
                <label class="form-check-label small" for="rememberMe">Remember me</label>
            </div>
            <button type="submit" class="login-btn" id="signInBtn">
                <i class="material-icons me-1">login</i> Sign In
            </button>
            <p class="mt-3"><a href="/forgot-password" class="forgot-link">Forgot Password?</a></p>
            <p class="auth-invitation">New to SRAAS? Ask your institution administrator for a registration invitation.</p>
        </form>

        <!-- Footer -->
        <footer class="registration-footer">Student Result Automation &amp; Analytics System</footer>
        </div>
    </div>
</section>

<script>
    (function() {
        // Password visibility toggle
        var toggleBtn = document.getElementById('togglePassword');
        var passwordInput = document.getElementById('passwordInput');
        var toggleIcon = document.getElementById('toggleIcon');
        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function() {
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    toggleIcon.textContent = 'visibility_off';
                } else {
                    passwordInput.type = 'password';
                    toggleIcon.textContent = 'visibility';
                }
                passwordInput.focus();
            });
        }

        // Loading state on form submit
        var form = document.getElementById('loginForm');
        var btn = document.getElementById('signInBtn');
        if (form && btn) {
            form.addEventListener('submit', function() {
                btn.classList.add('loading');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Signing in...';
            });
        }
    })();
</script>
