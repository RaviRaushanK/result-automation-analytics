<section class="registration-page auth-page">
    <div class="registration-shell auth-shell">
        <%- include('partials/welcome-panel', { recovery: true }) %>
        <div class="registration-card auth-card">
        <form method="POST" action="/reset-password" class="auth-form" id="resetPasswordForm">
            <span class="registration-eyebrow">ACCOUNT RECOVERY</span>

            <h1>Reset your password</h1>
            <p class="auth-description">Choose a new password for your institution account. Enter it twice to confirm.</p>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show mt-3 w-100" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <input type="hidden" name="adminId" value="<%= typeof adminId !== 'undefined' ? adminId : '' %>">

            <div class="mb-3">
                <label for="reset-new-password">New password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="material-icons">lock</i></span>
                    <input type="password" id="reset-new-password" name="newPassword" class="form-control auth-password-input" placeholder="Enter a new password" required minlength="6" autocomplete="new-password" aria-describedby="reset-password-help">
                    <button type="button" class="password-toggle-btn" data-password-toggle="reset-new-password" aria-controls="reset-new-password" aria-label="Show new password" aria-pressed="false" hidden><span class="material-icons" aria-hidden="true">visibility</span></button>
                </div>
                <p id="reset-password-help" class="small mt-2">Use at least 6 characters.</p>
            </div>

            <div class="mb-3">
                <label for="reset-confirm-password">Confirm new password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="material-icons">lock</i></span>
                    <input type="password" id="reset-confirm-password" name="confirmPassword" class="form-control auth-password-input" placeholder="Re-enter your new password" required minlength="6" autocomplete="new-password">
                    <button type="button" class="password-toggle-btn" data-password-toggle="reset-confirm-password" aria-controls="reset-confirm-password" aria-label="Show confirm password" aria-pressed="false" hidden><span class="material-icons" aria-hidden="true">visibility</span></button>
                </div>
            </div>

            <button type="submit" class="login-btn" id="resetPasswordBtn">
                <i class="material-icons me-1">lock_reset</i> Update Password
            </button>

            <p class="mt-3"><a href="/login" class="auth-back"><span class="material-icons" aria-hidden="true">arrow_back</span>Back to sign in</a></p>
        </form>
        <footer class="registration-footer">Need help? Contact your institution administrator.</footer>
        </div>
    </div>
</section>

<script>
    (function() {
        var form = document.getElementById('resetPasswordForm');
        var btn = document.getElementById('resetPasswordBtn');
        if (form && btn) {
            form.addEventListener('submit', function() {
                btn.classList.add('loading');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Updating...';
            });
        }
    })();
</script>
<script src="/js/passwordVisibility.js" defer></script>
