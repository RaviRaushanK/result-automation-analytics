<section class="login-bg">
    <div class="login-container">
        <form method="POST" action="/reset-password" class="login-form" id="resetPasswordForm">
            <div class="login-logo">
                <i class="material-icons">lock_reset</i>
            </div>

            <h1 class="login-title">SRAAS</h1>
            <p class="login-subtitle">Reset Your Password</p>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show mt-3 w-100" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <input type="hidden" name="adminId" value="<%= typeof adminId !== 'undefined' ? adminId : '' %>">

            <div class="mb-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="material-icons">lock</i></span>
                    <input type="password" name="newPassword" class="form-control" placeholder="New Password" required minlength="6" autocomplete="new-password">
                </div>
            </div>

            <div class="mb-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="material-icons">lock</i></span>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm New Password" required minlength="6" autocomplete="new-password">
                </div>
            </div>

            <button type="submit" class="login-btn" id="resetPasswordBtn">
                <i class="material-icons me-1">lock_reset</i> Update Password
            </button>

            <p class="mt-3"><a href="/login" class="forgot-link">&larr; Back to Sign In</a></p>
        </form>
    </div>
</section>

<script>
    (function() {
        var form = document.getElementById('resetPasswordForm');
        var btn = document.getElementById('resetPasswordBtn');
        if (form && btn) {
            form.addEventListener('submit', function() {
                btn.classList.add('loading');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Updating...';
            });
        }
    })();
</script>
