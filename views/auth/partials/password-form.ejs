<form method="POST" action="/account-security">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% [['currentPassword','Current Password','current-password'],['newPassword','New Password','new-password'],['confirmPassword','Confirm New Password','new-password']].forEach(([name, label, autocomplete]) => { %>
    <div class="mb-3"><label class="form-label" for="<%= name %>"><%= label %></label><div class="position-relative"><input class="form-control pe-5" type="password" id="<%= name %>" name="<%= name %>" autocomplete="<%= autocomplete %>" <%= name === 'currentPassword' ? '' : 'minlength=6' %> required><button type="button" class="btn position-absolute top-50 end-0 translate-middle-y p-2 border-0" data-password-toggle="<%= name %>" aria-controls="<%= name %>" aria-label="Show <%= label.toLowerCase() %>" title="Show <%= label.toLowerCase() %>" aria-pressed="false" style="color: inherit" hidden><span class="material-icons d-block" aria-hidden="true">visibility</span></button></div></div>
  <% }); %>
  <button class="btn btn-primary d-inline-flex align-items-center gap-2" type="submit"><span class="material-icons" aria-hidden="true">lock_reset</span>Update Password</button>
</form>
<script src="/js/passwordVisibility.js" defer></script>
