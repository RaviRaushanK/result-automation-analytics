<div class="container py-4">
  <h1>Invite faculty</h1>
  <p>Invite an existing faculty member to view Dashboard, Analysis, and Reports and manage their personal settings. Their faculty code and email verification are required to register.</p>
  <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
  <% if (invitePath) { %><div class="alert alert-<%= typeof emailSent !== 'undefined' && emailSent ? 'success' : 'info' %>" role="status">Invitation created. <% if (typeof emailSent !== 'undefined' && emailSent) { %>The invitation email was accepted by the mail server<% if (typeof emailRecipient !== 'undefined') { %> for <strong><%= emailRecipient %></strong><% } %>. Ask the recipient to check their inbox and spam folder for “You are invited to join SRAAS”.<% } %> It expires in seven days. Creating a new invitation for the same faculty member or email revokes the previous one.</div>
    <% if (/^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])([:/]|$)/.test(invitePath)) { %><div class="alert alert-warning" role="status">This link is for local testing and only works on the computer running SRAAS. Configure the application's reachable URL before inviting users on other devices.</div><% } %>
    <label for="invitation-link">Invitation link</label><input id="invitation-link" class="form-control mb-4" readonly value="<%= invitePath %>">
    <script>document.getElementById('invitation-link').value = new URL(document.getElementById('invitation-link').value, location.origin).href;</script>
  <% } %>
  <% const invitationWasEmailed = typeof emailSent !== 'undefined' && emailSent; %>
  <% if (invitationWasEmailed) { %><details class="mt-3 mb-3"><summary class="fw-semibold text-primary">Invite another faculty member</summary><div class="mt-3"><% } %>
  <form method="post" action="/invitations">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="invite-faculty">Faculty member</label><select id="invite-faculty" name="facultyId" class="form-select mb-3" required><option value="">Select faculty</option><% faculty.forEach(member => { %><option value="<%= member.faculty_id %>"><%= member.faculty_name %> (<%= member.faculty_code %>)</option><% }); %></select>
    <% if (!faculty.length) { %><p role="status">No eligible faculty are available. Add an active faculty record before creating an invitation.</p><% } %>
    <label for="invite-email">Email address of the faculty member</label><input class="form-control" id="invite-email" name="email" type="email" autocomplete="email" data-account-email maxlength="100" aria-describedby="invite-email-help" required>
    <p id="invite-email-help" class="form-text mt-2 mb-3">Enter the email for the selected faculty member. An email on their faculty record is not required. They must verify this same address during registration.</p>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <button class="btn btn-primary rounded-3 px-4 py-2" type="submit">Create &amp; email invitation</button>
    </div>
  </form>
  <% if (invitationWasEmailed) { %></div></details><% } %>
  <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3 px-4 py-2 text-decoration-none mt-3" href="/settings?section=account"><span class="material-icons" aria-hidden="true">arrow_back</span>Back to settings</a>
</div>
<script src="/js/accountEmailValidation.js" defer></script>
