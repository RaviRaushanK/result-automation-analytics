<section class="login-bg">
    <div class="login-container">
        <form method="POST" action="/verify-reset-otp" class="login-form" id="verifyOtpForm">
            <div class="login-logo">
                <i class="material-icons">verify</i>
            </div>

            <h1 class="login-title">SRAAS</h1>
            <p class="login-subtitle">Verify Your Email</p>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show mt-3 w-100" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <input type="hidden" name="adminId" value="<%= typeof adminId !== 'undefined' ? adminId : '' %>">
            <input type="hidden" name="type" value="<%= typeof type !== 'undefined' ? type : 'password_reset' %>">

            <div class="mb-3">
                <p class="otp-hint"><%= (typeof maskedDestination !== 'undefined' && maskedDestination) ? 'A verification code has been sent to ' + maskedDestination : 'A verification code has been sent to your registered email address.' %></p>
            </div>

            <div class="mb-3 otp-input-group">
                <input type="text" name="otp" class="form-control text-center otp-input" maxlength="6" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" required inputmode="numeric" pattern="[0-9]*">
            </div>

            <button type="submit" class="login-btn" id="verifyOtpBtn">
                <i class="material-icons me-1">verify</i> Verify Code
            </button>

            <div class="mt-3 resend-box">
                <span class="resend-timer" id="resendTimer"></span>
                <button type="button" class="resend-link" id="resendOtpBtn" disabled>Resend Code</button>
            </div>

            <p class="mt-3"><a href="/login" class="forgot-link">&larr; Back to Sign In</a></p>
        </form>
    </div>
</section>

<script>
    (function() {
        var adminId = '<%= adminId %>';
        var type = '<%= type || "password_reset" %>';
        var resendInSeconds = <%= (typeof resendInSeconds !== 'undefined') ? parseInt(resendInSeconds) : 60 %>;
        var resendBtn = document.getElementById('resendOtpBtn');
        var timerEl = document.getElementById('resendTimer');
        var remaining = resendInSeconds;

        function updateResendUI() {
            if (remaining > 0) {
                timerEl.textContent = 'Code can be resent in ' + remaining + ' second(s).';
                resendBtn.disabled = true;
                remaining--;
                setTimeout(updateResendUI, 1000);
            } else {
                timerEl.textContent = '';
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend Code';
            }
        }
        updateResendUI();

        resendBtn.addEventListener('click', function() {
            fetch('/resend-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'adminId=' + encodeURIComponent(adminId) + '&type=' + encodeURIComponent(type)
            }).then(function(r) { return r.json(); }).then(function(data) {
                if (data.ok) {
                    remaining = data.resendInSeconds || 60;
                    updateResendUI();
                } else {
                    alert(data.error || 'Unable to resend code.');
                }
            }).catch(function() {
                alert('Unable to resend code.');
            });
        });

        var form = document.getElementById('verifyOtpForm');
        var btn = document.getElementById('verifyOtpBtn');
        if (form && btn) {
            form.addEventListener('submit', function() {
                btn.classList.add('loading');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Verifying...';
            });
        }
    })();
</script>
