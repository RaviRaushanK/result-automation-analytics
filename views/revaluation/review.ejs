<div class="container-fluid revaluation-ui">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h4 class="mb-1"><i class="material-icons me-1">fact_check</i> Revaluation — Review &amp; Validate</h4>
      <p class="text-muted mb-0">
        Correct or accept/reject the OCR candidates. Server recalculates every total, status and grade;
        originals stay untouched until approval.
      </p>
    </div>
    <div class="col-auto">
      <% if (mode === 'edit') { %><span class="badge bg-primary">EDIT</span>
      <% } else if (mode === 'confirm') { %><span class="badge bg-warning text-dark">CONFIRM APPROVAL</span>
      <% } else { %><span class="badge bg-success">VALIDATED — READY TO APPROVE</span><% } %>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (notice) { %><div class="alert alert-info"><%= notice %></div><% } %>

  <div class="card mb-3">
    <div class="card-header">Server-authoritative context (from the database)</div>
    <div class="card-body">
      <p class="mb-1"><strong>Import ID:</strong> <%= meta.importId %> &middot; <strong>Result ID:</strong> <%= meta.resultId %></p>
      <p class="mb-1"><strong>Student:</strong> <%= meta.studentName || '—' %> (<%= meta.studentUsn || '—' %>)</p>
      <p class="mb-1"><strong>Session:</strong> <%= meta.sessionDisplay || '—' %></p>
      <p class="mb-0"><strong>Attempt:</strong> #<%= meta.attemptNo %> &middot;
        <span class="badge bg-info text-dark"><%= meta.examType %></span>
        <% if (meta.docUrl) { %> &middot;
          <a href="<%= meta.docUrl %>" target="_blank" class="small">
            <i class="material-icons align-middle" style="font-size:16px;">picture_as_pdf</i> <%= meta.docName || 'document' %>
          </a>
        <% } %>
      </p>
    </div>
  </div>

  <% if (meta.warnings.length) { %>
    <div class="alert alert-warning py-2">
      <ul class="mb-0"><% meta.warnings.forEach(w => { %><li><%= w %></li><% }) %></ul>
    </div>
  <% } %>

  <%#
    PHASE 4 — OCR state summary. Sections below are READ-ONLY reference
    views except the missing-section "Add" button.
    1. Detected (matched) subjects
    2. Unmatched OCR rows (not selected)
    3. Missing subjects (selected, not detected)
  %>
  <% const detectedRows = rows.filter(r => r.evidence && r.evidence.match_state === 'MATCHED'); %>
  <% const unmatchedRows = meta.unmatched || []; %>
  <% const missingRows = missingSubjects || []; %>

  <div class="card mb-3 border-success">
    <div class="card-header bg-success text-white">
      <strong><i class="material-icons align-middle me-1" style="font-size:16px;">check_circle</i> Detected Subjects (matched on the revaluation card)</strong>
      <span class="badge bg-light text-dark ms-2"><%= detectedRows.length %></span>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Subject Code</th><th>Subject Name</th>
            <th class="text-center">Internal<br>Marks</th>
            <th class="text-center">Old<br>Marks</th>
            <th class="text-center">Old<br>Result</th>
            <th class="text-center">RV<br>Marks</th>
            <th class="text-center">RV<br>Result</th>
            <th class="text-center">Final<br>Marks</th>
            <th class="text-center">Final<br>Result</th>
            <th>Match</th>
          </tr>
        </thead>
        <tbody>
          <% if (detectedRows.length === 0) { %>
            <tr><td colspan="10" class="text-center text-muted py-3">No subjects were detected on the revaluation card.</td></tr>
          <% } else { detectedRows.forEach(r => { const ev = r.evidence; %>
            <tr>
              <td><code><%= ev.subjectCode || r.code || '—' %></code></td>
              <td><%= ev.subjectName || r.name || '—' %></td>
              <td class="text-center"><%= ev.internalMarks != null ? ev.internalMarks : '—' %></td>
              <td class="text-center"><%= ev.oldMarks != null ? ev.oldMarks : '—' %></td>
              <td class="text-center"><%= ev.oldResult || '—' %></td>
              <td class="text-center"><%= ev.rvMarks != null ? ev.rvMarks : '—' %></td>
              <td class="text-center"><%= ev.rvResult || '—' %></td>
              <td class="text-center fw-bold"><%= ev.finalMarks != null ? ev.finalMarks : '—' %></td>
              <td class="text-center"><% if (ev.finalResult) { %>
                  <% const _frColor = (function() {
                       const u = String(ev.finalResult).toUpperCase();
                       if (u === 'P' || u === 'PASS') return 'success';
                       if (u === 'F' || u === 'FAIL' || u === 'ABSENT') return 'danger';
                       if (u === 'NE' || u === 'X') return 'warning text-dark';
                       return 'secondary';
                     })(); %>
                  <span class="badge bg-<%= _frColor %>"><%= ev.finalResult %></span>
                <% } else { %>—<% } %></td>
              <td><span class="badge bg-success">MATCHED</span>
                <% if (ev.confidence) { %><span class="badge bg-secondary ms-1"><%= ev.confidence %></span><% } %>
              </td>
            </tr>
          <% }) } %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (unmatchedRows.length > 0) { %>
    <div class="card mb-3 border-warning">
      <div class="card-header bg-warning text-dark">
        <strong><i class="material-icons align-middle me-1" style="font-size:16px;">warning</i>
          Unmatched / Not Selected (OCR detected these, but they are not in the selected list)</strong>
        <span class="badge bg-dark ms-2"><%= unmatchedRows.length %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle mb-0">
          <thead class="table-light">
            <tr><th>OCR Subject Code</th><th>Raw line (first 80 chars)</th><th>Match State</th></tr>
          </thead>
          <tbody>
            <% unmatchedRows.forEach(u => { %>
              <tr>
                <td><code><%= u.ocr_subject_code || '—' %></code></td>
                <td><small class="text-muted"><%= u.raw_line ? u.raw_line.substring(0, 80) : '—' %></small></td>
                <td><span class="badge bg-secondary">UNMATCHED / NOT SELECTED</span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="card mb-3 border-danger">
    <div class="card-header bg-danger text-white">
      <strong><i class="material-icons align-middle me-1" style="font-size:16px;">error</i>
        Missing / Not Detected (selected subjects OCR did not find on the card)</strong>
      <span class="badge bg-light text-dark ms-2"><%= missingRows.length %></span>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr><th>Subject Code</th><th>Subject Name</th><th class="text-center">Original Marks</th>
              <th class="text-center">Original Status</th><th>State</th><th class="text-center">Action</th></tr>
        </thead>
        <tbody>
          <% if (missingRows.length === 0) { %>
            <tr><td colspan="6" class="text-center text-success py-3">No missing subjects.</td></tr>
          <% } else { missingRows.forEach(function(m, idx) {
              const mSrid  = Number(m.subject_result_id || m.srid || 0);
              const mCode  = m.subject_code  || m.code  || ('#' + mSrid);
              const mName  = m.subject_name  || m.name  || '—';
              const mMarks = (m.original_marks != null ? m.original_marks : (m.marks != null ? m.marks : '—'));
              const mStat  = m.original_status || m.result_status || '—';
          %>
            <tr>
              <td><code><%= mCode %></code></td>
              <td><%= mName %></td>
              <td class="text-center"><%= mMarks %></td>
              <td class="text-center">
                <span class="badge bg-<%= String(mStat).toLowerCase() === 'pass' ? 'success' : 'danger' %>"><%= mStat %></span>
              </td>
              <td><span class="badge bg-dark">NOT DETECTED</span></td>
              <td class="text-center">
                <% if (mode === 'edit') { %>
                  <button type="button" class="btn btn-sm btn-outline-primary add-missing-btn"
                    data-missing-idx="<%= idx %>" data-srid="<%= mSrid %>"
                    data-code="<%= mCode %>" data-name="<%= mName.replace(/"/g, '&quot;') %>">
                    <i class="material-icons align-middle" style="font-size:14px;">add</i> Add
                  </button>
                <% } else { %><span class="text-muted small">edit mode only</span><% } %>
              </td>
            </tr>

            <% if (mode === 'edit') { %>
              <tr class="add-missing-form-row" data-missing-idx="<%= idx %>" style="display:none; background:#fffbea;">
                <td colspan="6">
                  <form method="POST" action="/revaluation/review/<%= meta.importId %>/add-missing" class="add-missing-form p-2" data-missing-idx="<%= idx %>">
                    <input type="hidden" name="subject_result_id" value="<%= mSrid %>" />
                    <p class="mb-2 small">
                      <strong>Manual entry for <code><%= mCode %></code> — <%= mName %></strong>
                      <span class="text-muted">(#<%= mSrid %> · server re-reads authoritative data)</span>
                    </p>
                    <div class="row g-2 align-items-end">
                      <div class="col-auto"><label class="form-label small mb-1">Internal</label>
                        <input type="number" min="0" class="form-control form-control-sm" name="card_internal_marks" placeholder="Int" /></div>
                      <div class="col-auto"><label class="form-label small mb-1">Old Marks</label>
                        <input type="number" min="0" class="form-control form-control-sm" name="card_old_marks" value="<%= mMarks !== '—' ? mMarks : '' %>" placeholder="Old" /></div>
                      <div class="col-auto"><label class="form-label small mb-1">Old Result</label>
                        <select class="form-select form-select-sm" name="card_old_result">
                          <option value="">—</option>
                          <option value="pass" <%= String(mStat).toLowerCase() === 'pass' ? 'selected' : '' %>>pass</option>
                          <option value="fail" <%= String(mStat).toLowerCase() === 'fail' ? 'selected' : '' %>>fail</option>
                        </select></div>
                      <div class="col-auto"><label class="form-label small mb-1">RV Marks</label>
                        <input type="number" min="0" class="form-control form-control-sm" name="card_rv_marks" placeholder="RV" /></div>
                      <div class="col-auto"><label class="form-label small mb-1">RV Result</label>
                        <select class="form-select form-select-sm" name="card_rv_result">
                          <option value="">—</option><option value="pass">pass</option><option value="fail">fail</option>
                        </select></div>
                      <div class="col-auto"><label class="form-label small mb-1 text-danger fw-bold">Final Marks *</label>
                        <input type="number" min="0" class="form-control form-control-sm" name="card_final_marks" placeholder="Final" required /></div>
                      <div class="col-auto"><label class="form-label small mb-1 text-danger fw-bold">Final Result *</label>
                        <select class="form-select form-select-sm" name="card_final_result" required>
                          <option value="">—</option><option value="pass">pass</option><option value="fail">fail</option>
                        </select></div>
                      <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary"><i class="material-icons align-middle" style="font-size:14px;">save</i> Save</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1 cancel-missing-btn" data-missing-idx="<%= idx %>">Cancel</button>
                      </div>
                    </div>
                  </form>
                </td>
              </tr>
            <% } %>
          <% }) } %>
        </tbody>
      </table>
    </div>
  </div>

  <form method="POST" action="/revaluation/review/<%= meta.importId %>" id="reviewForm"
        class="<%= mode === 'edit' ? '' : 'review-frozen' %>">
    <div class="card mb-3">
      <div class="card-header">Subjects selected for revaluation (<%= rows.length %>)</div>
      <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle mb-0" id="reviewTable">
          <thead class="table-light">
            <tr>
              <th style="min-width:150px;">Subject</th>
              <th class="text-start">Original<br>(total)</th>
              <th style="min-width:200px;">OCR evidence</th>
              <th style="width:90px;" class="text-center">Rev. Int</th>
              <th style="width:90px;" class="text-center">Rev. Ext</th>
              <th style="width:80px;" class="text-center">Derived total</th>
              <th style="width:110px;" class="text-center">Decision</th>
            </tr>
          </thead>
          <tbody>
<%
  const ACK_LETTERS = ['ABSENT', 'WITHHELD', 'NOT_ELIGIBLE', 'A', 'W', 'X', 'NE'];
  const propBySrid = {};
  if (review && Array.isArray(review.proposal)) {
    review.proposal.forEach(p => { propBySrid[p.subject_result_id] = p; });
  }
  const editable = (mode === 'edit');
  const codeOfSrid = {};
  rows.forEach(r => { codeOfSrid[r.srid] = r.code; });
%>
<% rows.forEach(r => { const ev = r.evidence; %>
<%
  const entered = (enteredVals && enteredVals[r.srid]) || null;
  // PROMPT 14: pre-fill from server-side preferred values (prior proposal > OCR).
  // The controller already orders these in r.evidence.revised_int/ext; if a prior
  // frozen proposal exists for this target, it wins.
  const hasPrefill = (ev.revised_int !== null && ev.revised_int !== undefined)
                  || (ev.revised_ext !== null && ev.revised_ext !== undefined);
  const preInt = entered ? entered.internal
    : ((ev.revised_int !== null && ev.revised_int !== undefined) ? String(ev.revised_int) : '');
  const preExt = entered ? entered.external
    : ((ev.revised_ext !== null && ev.revised_ext !== undefined) ? String(ev.revised_ext) : '');
  // PROMPT 14: default the accept/reject radio to mirror the prior frozen
  // decision when one exists (so re-edits preserve user intent). When no
  // prior proposal exists, default to accept only when OCR provided both
  // components (preserves the previous behaviour for first-time edits).
  const defAccept = r.priorDecision
    ? (r.priorDecision === 'accept')
    : (ev.match_state === 'MATCHED' && preInt !== '' && preExt !== '');
  const needAck = !!ev.raw_letter &&
    ACK_LETTERS.indexOf(String(ev.raw_letter).trim().toUpperCase()) !== -1;
  const rowErrs = (errors && errors[r.srid]) ? errors[r.srid] : [];
  const prop = propBySrid[r.srid] || null;
%>
            <tr class="<%= prop && prop.decision === 'reject' ? 'table-light text-muted' : '' %>">
              <td>
                <strong><%= r.code %></strong><br>
                <small class="text-muted"><%= r.name %></small><br>
                <small>credits <%= r.credits %> &middot; max I/E/T: <%= r.maxInternal %>/<%= r.maxExternal %>/<%= r.maxMarks %></small>
              </td>
              <td class="text-start">
                <span class="fw-bold"><%= r.origMarks !== null ? r.origMarks : '—' %></span><br>
                <span class="badge bg-<%= r.origStatus === 'pass' ? 'success' : 'danger' %>"><%= r.origStatus || '—' %></span>
                <% if (r.origGrade) { %><small class="text-muted d-block"><%= r.origGrade %></small><% } %>
              </td>
              <td>
                <span class="badge bg-<%= ev.match_state === 'MATCHED' ? 'success' : (ev.match_state === 'AMBIGUOUS' ? 'warning text-dark' : 'secondary') %>">
                  <%= ev.match_state %>
                </span>
                <% if (ev.ocr_subject_code) { %>
                  <code><%= ev.ocr_subject_code %></code>
                  <small class="text-muted d-block">normalized: <%= ev.normalized || '—' %></small>
                  <% if (ev.raw_line) { %><small class="text-muted d-block" title="<%= ev.raw_line %>">raw line available</small><% } %>
                <% } else { %>
                  <small class="text-muted">not found on document</small>
                <% } %>
                <div class="mt-1">
                  <small>doc status:</small>
                  <% if (ev.raw_letter) { %>
                    <code><%= ev.raw_letter %></code>
                    <% if (ev.status_candidate) { %><span class="badge bg-info text-dark"><%= ev.status_candidate %></span><% } else { %><span class="badge bg-dark">unmapped</span><% } %>
                  <% } else { %><span class="text-muted">—</span><% } %>
                  <% if (ev.confidence) { %><span class="badge bg-secondary ms-1"><%= ev.confidence %></span><% } %>
                </div>
                <% if (editable && ev.ambiguous && r.pickOptions.length) { %>
                  <div class="mt-1">
                    <label class="form-label small mb-0" for="pick_<%= r.srid %>">Bind this doc row to:</label>
                    <select id="pick_<%= r.srid %>" name="ambiguous_pick_<%= r.srid %>" class="form-select form-select-sm">
                      <option value="">— choose subject —</option>
                      <% r.pickOptions.forEach(o => { %>
                        <option value="<%= o.id %>" <%= (entered && entered.pick === String(o.id)) ? 'selected' : '' %>>
                          <%= o.code %> (#<%= o.id %>)
                        </option>
                      <% }) %>
                    </select>
                  </div>
                <% } %>
              </td>
<% if (!editable && prop) { %>
              <td colspan="2" class="text-center">
                <% if (prop.decision === 'accept') { %>
                  <span class="fw-bold"><%= prop.proposed_revised_internal_marks %> + <%= prop.proposed_revised_external_marks %> =
                    <%= prop.proposed_revised_total_marks %></span><br>
                  <span class="badge bg-<%= prop.proposed_revised_status === 'pass' ? 'success' : 'danger' %>"><%= prop.proposed_revised_status %></span>
                  <small><%= prop.proposed_revised_grade %></small>
                  <% if (prop.was_manual_correction) { %><small class="text-muted d-block">manually corrected</small><% } %>
                  <% if (prop.bound_to_srid && Number(prop.bound_to_srid) !== r.srid) { %>
                    <small class="text-muted d-block">bound to #<%= prop.bound_to_srid %></small>
                  <% } %>
                <% } else { %>
                  <span class="badge bg-secondary">REJECTED</span>
                  <small class="d-block text-muted">no event will be created</small>
                <% } %>
              </td>
<% } else { %>
              <td class="text-center">
                <input type="number" min="0" max="<%= r.maxInternal %>" step="1"
                       name="internal_<%= r.srid %>" id="int_<%= r.srid %>"
                       value="<%= preInt %>" class="form-control form-control-sm rev-int"
                       data-srid="<%= r.srid %>" <%= editable ? '' : 'disabled' %>>
              </td>
              <td class="text-center">
                <input type="number" min="0" max="<%= r.maxExternal %>" step="1"
                       name="external_<%= r.srid %>" id="ext_<%= r.srid %>"
                       value="<%= preExt %>" class="form-control form-control-sm rev-ext"
                       data-srid="<%= r.srid %>" <%= editable ? '' : 'disabled' %>>
              </td>
              <td class="text-center">
                <span id="tot_<%= r.srid %>" class="fw-bold text-primary">—</span>
                <small class="text-muted d-block">auto int+ext</small>
              </td>
<% } %>
              <td class="text-center">
                <% if (editable) { %>
                  <div class="form-check">
                    <input class="form-check-input rev-decision" type="radio"
                           name="decision_<%= r.srid %>" value="accept" data-srid="<%= r.srid %>"
                           <%= defAccept ? 'checked' : '' %>>
                    <label class="form-check-label small">Accept</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input rev-decision" type="radio"
                           name="decision_<%= r.srid %>" value="reject" data-srid="<%= r.srid %>"
                           <%= defAccept ? '' : 'checked' %>>
                    <label class="form-check-label small">Reject</label>
                  </div>
                  <% if (needAck) { %>
                    <div class="form-check mt-1 text-start">
                      <input class="form-check-input" type="checkbox" name="ack_<%= r.srid %>" value="on"
                             <%= (entered && entered.ack) ? 'checked' : '' %>>
                      <label class="form-check-label small text-wrap" style="max-width:150px;">
                        I acknowledge the unrepresentable document letter
                      </label>
                    </div>
                  <% } %>
                <% } else if (!prop) { %>
                  <span class="text-muted small">no decision saved</span>
                <% } else { %>
                  <span class="badge bg-<%= prop.decision === 'accept' ? 'primary' : 'secondary' %>">
                    <%= prop.decision.toUpperCase() %>
                  </span>
                <% } %>
                <% if (rowErrs.length) { %>
                  <div class="text-danger small mt-1 text-start">
                    <% rowErrs.forEach(e => { %><div><%= e %></div><% }) %>
                  </div>
                <% } %>
              </td>
            </tr>
<% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (mode === 'edit') { %>
      <div class="d-flex gap-2 mb-4 flex-wrap">
        <button type="submit" class="btn btn-primary">
          <i class="material-icons align-middle me-1" style="font-size:18px;">save</i>Save decisions &amp; validate
        </button>
        <a href="/revaluation/extraction/<%= meta.importId %>" class="btn btn-outline-secondary">Back to extraction</a>
        <% if (meta.sessionId) { %>
          <a href="/revaluation/start/students?session=<%= meta.sessionId %>" class="btn btn-outline-secondary">Back to Students</a>
        <% } %>
      </div>
    <% } %>
  </form>

  <% if (mode !== 'edit' && review) { %>
    <div class="card mb-3 border-success">
      <div class="card-header">Validated decisions snapshot
        <small class="text-muted">(saved <%= review.submitted_at || '' %> by admin #<%= review.submitted_by || '—' %>)</small></div>
      <div class="card-body">
        <% if (review.aggregate_preview) { %>
          <p class="mb-1"><strong>Derived effective preview:</strong>
            overall <%= review.aggregate_preview.overall_result %> &middot;
            SGPA <%= review.aggregate_preview.sgpa %> &middot;
            CGPA <%= review.aggregate_preview.cgpa === null ? '—' : review.aggregate_preview.cgpa %> &middot;
            failed <%= review.aggregate_preview.failed_subject_count %>
            <small class="text-muted">(display analytics — Result rows are never written)</small></p>
        <% } %>
      <% if (mode === 'locked') { %>
        <a href="/revaluation/approve/<%= meta.importId %>" class="btn btn-success btn-lg">
          <i class="material-icons align-middle me-1">verified</i>Proceed to approval confirmation
        </a>
      <% } else { %>
        <div class="alert alert-danger py-2 mb-2">
          Approving will create approved + effective <code>RevaluationResult</code> events for every accepted subject
          and permanently demote any earlier effective event for those subjects. Originals are never modified.
        </div>
        <div class="d-flex gap-2">
          <form method="POST" action="/revaluation/approve/<%= meta.importId %>">
            <button type="submit" class="btn btn-danger btn-lg">
              <i class="material-icons align-middle me-1">task_alt</i>Approve &amp; create revaluation events
            </button>
          </form>
          <a href="/revaluation/review/<%= meta.importId %>" class="btn btn-outline-secondary btn-lg align-self-center">Cancel</a>
        </div>
      <% } %>
      </div>
    </div>
  <% } %>

  <%# PHASE 4: Unmatched OCR section header (detected + unmatched already shown above) %>
  <div class="row">
    <div class="col-lg-6">
      <div class="card mb-3">
        <div class="card-header">Unmatched OCR subject codes (informational)</div>
        <div class="card-body">
          <% if (!meta.unmatched.length) { %>
            <p class="text-success mb-0">None.</p>
          <% } else { %>
            <ul class="mb-0"><% meta.unmatched.forEach(u => { %><li><code><%= u.ocr_subject_code %></code></li><% }) %></ul>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card mb-3">
        <div class="card-header">Raw extracted text</div>
        <div class="card-body">
          <details>
            <summary class="text-primary">Show raw text (<%= (meta.rawText || '').length %> chars)</summary>
            <pre class="small text-muted mb-0" style="white-space:pre-wrap; max-height:360px; overflow:auto;"><%= meta.rawText || '—' %></pre>
          </details>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-2 mb-4 d-flex gap-2 flex-wrap">
    <a href="/revaluation/pending/<%= meta.importId %>" class="btn btn-outline-secondary btn-sm">
      <i class="material-icons">arrow_back</i> Back to pending record
    </a>
    <% if (meta.sessionId) { %>
      <a href="/revaluation/start/students?session=<%= meta.sessionId %>" class="btn btn-outline-secondary btn-sm">
        <i class="material-icons">arrow_back</i> Back to Students
      </a>
    <% } %>
    <a href="/revaluation/upload" class="btn btn-outline-secondary btn-sm">
      <i class="material-icons">arrow_back</i> Back to result selection
    </a>
  </div>
</div>
<script src="/js/revaluation-review.js"></script>
