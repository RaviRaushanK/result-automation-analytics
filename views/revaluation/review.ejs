<% const previewIdentityBlocked = typeof identityBlocking !== "undefined" && identityBlocking; %>
<div class="container-fluid revaluation-ui">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h4 class="mb-1"><i class="material-icons me-1">fact_check</i> Revaluation — Review &amp; Validate</h4>
      <p class="text-muted mb-0"><%= meta.studentName %> &middot; <%= meta.studentUsn %></p>
    </div>
    <div class="col-auto">
      <% if (mode === 'edit') { %><span class="badge bg-primary">EDIT</span>
      <% } else if (mode === 'confirm') { %><span class="badge bg-warning text-dark">CONFIRM APPROVAL</span>
      <% } else { %><span class="badge bg-success">VALIDATED — READY TO APPROVE</span><% } %>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-danger" role="alert"><% if (typeof validationFailed !== 'undefined' && validationFailed) { %><strong>Validation Failed</strong><div class="mt-1"><%= error %></div><% } else { %><%= error %><% } %></div><% } %>
  <% if (notice) { %><div class="alert alert-info"><%= notice %></div><% } %>

  <%- include("partials/identity-preview") %>

  <div class="mb-3 revaluation-preview-context">
    <div>
      <p class="mb-1"><strong>Exam Session:</strong> <%= meta.sessionDisplay || '—' %></p>
      <p class="mb-0"><strong>Attempt:</strong> #<%= meta.attemptNo %> &middot;
        <span class="badge bg-info text-dark"><%= meta.examType %></span>
      </p>
    </div>
  </div>

  <% if (meta.warnings.length) { %>
    <div class="alert alert-warning py-2">
      <ul class="mb-0"><% meta.warnings.forEach(w => { %><li><%= w %></li><% }) %></ul>
    </div>
  <% } %>

  <% if (meta.documentChecks) {
    // Presentation only. These groups never participate in validation or approval.
    const allRows = typeof rows !== 'undefined' ? rows : [];
    const manualRows = allRows.filter(row => row.evidence?.manual_candidate || row.evidence?.manual_entry);
    const manualAccepting = row => (typeof enteredVals !== 'undefined' && enteredVals?.[row.srid]?.decision || row.priorDecision) === 'accept';
    const manualConfirmed = row => typeof enteredVals !== 'undefined' && enteredVals?.[row.srid]
      ? enteredVals[row.srid].manualVerified === true : review?.identity_verified?.['manual_subject_' + row.srid] === true;
    const selectedManualCount = manualRows.filter(manualAccepting).length;
    const confirmedManualCount = manualRows.filter(row => manualAccepting(row) && manualConfirmed(row)).length;
    const subjectRows = allRows.filter(row => !row.evidence?.manual_candidate && !row.evidence?.manual_entry);
    const subjectGroups = subjectRows.map(row => ({ code: row.code, row, checks: [] }));
    const contextChecks = [];
    const needsAttention = check => check.status === 'MISMATCH' || (!check.derived && check.status !== 'MATCH');
    meta.documentChecks.forEach(check => {
      if (check.key?.startsWith('manual_subject_')) return;
      const code = /^(?:Subject|Old external marks|Old external result) (.+)$/.exec(check.field)?.[1];
      if (!code && !check.subject_result_id) { contextChecks.push(check); return; }
      let group = subjectGroups.find(group => check.subject_result_id
        ? String(group.row?.srid || group.subjectResultId) === String(check.subject_result_id) || (!group.row && !group.subjectResultId && group.code === code)
        : [group.code, group.row?.evidence?.subjectCode, group.row?.evidence?.ocr_subject_code].includes(code));
      if (!group) { group = { code: code || '#' + check.subject_result_id, checks: [] }; subjectGroups.push(group); }
      if (check.subject_result_id) group.subjectResultId = check.subject_result_id;
      group.checks.push(check);
    });
    subjectGroups.forEach(group => {
      group.errors = typeof errors !== 'undefined' && errors?.[group.row?.srid] || [];
      const state = group.row?.evidence?.match_state;
      group.status = group.checks.some(check => check.status === 'MISMATCH') || group.errors.length
        ? 'MISMATCH'
        : !group.checks.length || group.checks.some(check => !check.derived && check.status !== 'MATCH')
          || (state && state !== 'MATCHED')
          || (contextChecks.some(check => check.key === 'old_marks' && check.status === 'UNVERIFIED')
            && !group.checks.some(check => check.field.startsWith('Old external marks ')))
          ? 'MANUAL VERIFICATION REQUIRED' : 'VERIFIED';
    });
    const verified = subjectGroups.filter(group => group.status === 'VERIFIED');
    const mismatched = subjectGroups.filter(group => group.status === 'MISMATCH');
    const manual = subjectGroups.filter(group => group.status === 'MANUAL VERIFICATION REQUIRED');
    const contextIssues = contextChecks.filter(needsAttention);
    const allVerified = subjectGroups.length > 0 && verified.length === subjectGroups.length && !contextIssues.length && !selectedManualCount;
  %>
    <section class="alert alert-info revaluation-top-message revaluation-verification" aria-labelledby="documentVerificationTitle" data-all-verified="<%= allVerified %>">
      <strong id="documentVerificationTitle">Document Verification</strong>
      <div class="d-flex flex-wrap gap-2 mt-1" data-verification-summary>
        <span><%= verified.length %> <%= verified.length === 1 ? 'subject' : 'subjects' %> verified</span>
        <span>&middot; <%= mismatched.length %> <%= mismatched.length === 1 ? 'mismatch' : 'mismatches' %></span>
        <span id="manualVerificationCount" data-manual-base="<%= manual.length %>">&middot; <%= manual.length + selectedManualCount - confirmedManualCount %> manual checks required</span>
        <span id="manualConfirmedCount" <%= confirmedManualCount ? '' : 'hidden' %>>&middot; <%= confirmedManualCount %> manually confirmed</span>
      </div>
      <div class="mt-2 verification-document-context">
        <% contextChecks.filter(check => !needsAttention(check)).forEach(check => { %>
          <div><strong><%= check.field %>:</strong> <%= check.expectedLabel ?? check.expected ?? check.documentLabel ?? check.document %> &mdash; <%= check.derived ? 'Derived from stored history' : 'Verified' %></div>
        <% }); %>
      </div>
      <% subjectGroups.filter(group => group.status !== 'VERIFIED').forEach(group => { %>
        <div class="verification-issue border rounded p-2 mt-2" role="alert">
          <strong><%= group.code %> &mdash; <%= group.status %></strong>
          <% group.checks.filter(needsAttention).forEach(check => { %>
            <%- include('partials/verification-check', { check }) %>
          <% }); %>
          <% group.errors.forEach(message => { %><div class="mt-1"><%= message %></div><% }); %>
          <% if (!group.row?.evidence?.manual_entry && (!group.checks.length || (group.row?.evidence?.match_state && group.row.evidence.match_state !== 'MATCHED'))) { %>
            <div class="mt-1">Subject evidence requires review: <%= group.row?.evidence?.match_state || 'No automatic verification available' %>.</div>
          <% } %>
        </div>
      <% }); %>
      <% contextIssues.forEach(check => { %>
        <div class="verification-issue border rounded p-2 mt-2" role="alert"><%- include('partials/verification-check', { check }) %></div>
      <% }); %>
      <% manualRows.forEach(row => {
        const manualRowActive = manualAccepting(row);
        const check = { field: 'Manual subject ' + row.code, key: 'manual_subject_' + row.srid, status: 'UNVERIFIED', derived: false,
          expected: 'OCR did not detect this subject. Confirm that it appears on the uploaded card and verify the marks entered below.' };
        const manualReview = typeof enteredVals !== 'undefined' && enteredVals?.[row.srid]
          ? { identity_verified: { [check.key]: enteredVals[row.srid].manualVerified === true } } : review;
      %>
        <div id="manual_issue_<%= row.srid %>" data-manual-subject-issue="<%= row.srid %>" class="verification-issue border rounded p-2 mt-2 <%= manualConfirmed(row) ? 'is-confirmed' : '' %>" role="alert" <%= manualRowActive ? '' : 'hidden' %>>
          <strong><%= row.code %> &mdash; <span id="manual_issue_status_<%= row.srid %>"><%= manualConfirmed(row) ? 'Manually confirmed' : 'MANUAL VERIFICATION REQUIRED' %></span></strong>
          <%- include('partials/verification-check', { check, review: manualReview, manualRowActive }) %>
        </div>
      <% }); %>
      <details class="verification-details mt-2">
        <summary class="py-1">View verification details</summary>
        <% subjectGroups.forEach(group => {
          const oldMarks = group.checks.find(check => check.field.startsWith('Old external marks '));
          const oldResult = group.checks.find(check => check.field.startsWith('Old external result '));
          const evidence = group.row?.evidence;
        %>
          <div class="border-top pt-2 mt-2">
            <strong><%= group.code %> &mdash; <%= group.status === 'VERIFIED' ? 'Verified' : group.status %></strong>
            <div>Old EX: <%= oldMarks?.expected ?? 'Unavailable' %> &middot; Old result: <%= oldResult?.derived_old_external_result || (['PASS', 'FAIL'].includes(oldResult?.expected) ? oldResult.expected : 'Unavailable') %></div>
            <% if (evidence?.revised_ext != null || evidence?.revised_total != null) { %>
              <div>Revised EX: <%= evidence.revised_ext ?? 'Unavailable' %> &middot; Effective total: <%= evidence.revised_total ?? 'Unavailable' %></div>
            <% } %>
            <details class="mt-1"><summary>Comparison evidence for <%= group.code %></summary>
              <% group.checks.forEach(check => { %>
                <div class="mt-1"><strong><%= check.field %>:</strong> <%= check.status === 'MATCH' ? 'Verified' : check.status %>
                  <div>Stored: <%= check.expectedLabel ?? check.expected ?? 'Unavailable' %> &middot; Document: <%= check.documentLabel ?? check.document ?? 'Unavailable' %></div>
                  <% if (check.printed_old_external_result != null) { %><div>Printed old result: <%= check.printed_old_external_result %> &middot; Derived old result: <%= check.derived_old_external_result %></div><% } %>
                  <% if (check.manual && check.corrected) { %><div>Manual correction: <%= check.corrected %></div><% } %>
                </div>
              <% }); %>
              <% if (evidence) { %>
                <div class="mt-1">OCR subject: <%= evidence.ocr_subject_code ?? evidence.subjectCode ?? 'Unavailable' %> &middot; Normalized: <%= evidence.normalized ?? 'Unavailable' %></div>
                <div>Document old EX: <%= evidence.oldMarks ?? 'Unavailable' %> &middot; Document old result: <%= evidence.oldResult ?? 'Unavailable' %></div>
                <div>Document internal: <%= evidence.internalMarks ?? 'Unavailable' %> &middot; RV EX: <%= evidence.rvMarks ?? 'Unavailable' %> &middot; Final marks: <%= evidence.finalMarks ?? 'Unavailable' %></div>
                <div>Revised internal: <%= evidence.revised_int ?? 'Unavailable' %> &middot; RV result: <%= evidence.rvResult ?? 'Unavailable' %> &middot; Final result: <%= evidence.finalResult ?? 'Unavailable' %></div>
                <div>Evidence state: <%= evidence.match_state ?? 'Unavailable' %> &middot; Confidence: <%= evidence.confidence ?? 'Unavailable' %></div>
                <% if (evidence.raw_line) { %><div>Raw OCR: <%= evidence.raw_line %></div><% } %>
              <% } %>
            </details>
          </div>
        <% }); %>
        <% contextChecks.filter(check => check.manual && check.corrected).forEach(check => { %>
          <div>Manual correction: <%= check.corrected %></div>
        <% }); %>
      </details>
    </section>
  <% } %>

  <%# Read-only evidence for document subjects, including unresolved rows. %>
  <% const detectedRows = rows.filter(r => r.evidence && r.evidence.match_state === 'MATCHED'); %>
  <% const unmatchedRows = meta.unmatched || []; %>

  <details class="mb-3 revaluation-ocr-evidence">
    <summary class="py-2">Extracted marks card details</summary>
    <div class="mb-2">
      <strong><i class="material-icons align-middle me-1" style="font-size:16px;">check_circle</i> Revaluation Subjects</strong>
      <span class="badge bg-light text-dark ms-2"><%= detectedRows.length %></span>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Subject Code</th><th>Subject Name</th>
            <th class="text-center">Internal<br>Marks</th>
            <th class="text-center">Old<br>Marks</th>
            <th class="text-center">Old<br>Result</th>
            <th class="text-center">RV<br>Marks</th>
            <th class="text-center">RV<br>Result</th>
            <th class="text-center">Final<br>Marks</th>
            <th class="text-center">Final<br>Result</th>
            <th>Match</th>
          </tr>
        </thead>
        <tbody>
          <% if (detectedRows.length === 0) { %>
            <tr><td colspan="10" class="text-center text-muted py-3">No subjects were detected on the revaluation card.</td></tr>
          <% } else { detectedRows.forEach(r => { const ev = r.evidence; %>
            <tr>
              <td><code><%= ev.subjectCode || r.code || '—' %></code></td>
              <td><%= ev.subjectName || r.name || '—' %></td>
              <td class="text-center"><%= ev.internalMarks != null ? ev.internalMarks : '—' %></td>
              <td class="text-center"><%= ev.oldMarks != null ? ev.oldMarks : '—' %></td>
              <td class="text-center"><%= ev.oldResult || '—' %></td>
              <td class="text-center"><%= ev.rvMarks != null ? ev.rvMarks : '—' %></td>
              <td class="text-center"><%= ev.rvResult || '—' %></td>
              <td class="text-center fw-bold"><%= ev.finalMarks != null ? ev.finalMarks : '—' %></td>
              <td class="text-center"><% if (ev.finalResult) { %>
                  <% const _frColor = (function() {
                       const u = String(ev.finalResult).toUpperCase();
                       if (u === 'P' || u === 'PASS') return 'success';
                       if (u === 'F' || u === 'FAIL' || u === 'ABSENT') return 'danger';
                       if (u === 'NE' || u === 'X') return 'warning text-dark';
                       return 'secondary';
                     })(); %>
                  <span class="badge bg-<%= _frColor %>"><%= ev.finalResult %></span>
                <% } else { %>—<% } %></td>
              <td><span class="badge bg-success">MATCHED</span>
                <% if (ev.confidence) { %><span class="badge bg-secondary ms-1"><%= ev.confidence %></span><% } %>
              </td>
            </tr>
          <% }) } %>
        </tbody>
      </table>
    </div>
  </details>

  <% if (unmatchedRows.length > 0) { %>
    <div class="card mb-3 border-warning">
      <div class="card-header bg-warning text-dark">
        <strong><i class="material-icons align-middle me-1" style="font-size:16px;">warning</i>
          Extracted subjects outside the selected Exam Session or original attempt</strong>
        <span class="badge bg-dark ms-2"><%= unmatchedRows.length %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle mb-0">
          <thead class="table-light">
            <tr><th>OCR Subject Code</th><th>Raw line (first 80 chars)</th><th>Match State</th></tr>
          </thead>
          <tbody>
            <% unmatchedRows.forEach(u => { %>
              <tr>
                <td><code><%= u.ocr_subject_code || '—' %></code></td>
                <td><small class="text-muted"><%= u.raw_line ? u.raw_line.substring(0, 80) : '—' %></small></td>
                <td><span class="badge bg-danger">Subject does not belong to the selected Exam Session</span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="revaluation-preview-grid">
    <section class="revaluation-preview-document">
      <div class="result-review-section-heading">
        <h6 class="mb-0">Original Revaluation Card</h6>
        <% if (meta.docUrl) { %>
          <a href="<%= meta.docUrl %>" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm"><i class="material-icons" aria-hidden="true">open_in_new</i> Open</a>
        <% } %>
      </div>
      <div class="revaluation-preview-document-body">
        <% if (meta.docUrl) { %>
          <% if (['png', 'jpg', 'jpeg'].includes(meta.docType)) { %>
            <div class="revaluation-document-image-scroll">
              <img src="<%= meta.docUrl %>" alt="Original revaluation marks card" class="revaluation-document-image">
            </div>
          <% } else { %>
            <iframe src="<%= meta.docUrl %><%= String(meta.docUrl).includes('#') ? '&' : '#' %>view=FitH" title="Original revaluation marks card" class="revaluation-document-frame"></iframe>
          <% } %>
        <% } else { %>
          <p class="text-muted p-3">Original document is unavailable.</p>
        <% } %>
      </div>
    </section>
  <form method="POST" action="/revaluation/review/<%= meta.importId %>" id="reviewForm"
        class="revaluation-preview-editor needs-validation <%= mode === 'edit' ? '' : 'review-frozen' %>" novalidate>
    <input type="hidden" name="source_token" value="<%= meta.sourceToken || '' %>">
    <input type="hidden" name="identity_review" value="1">
    <% const identityValues = meta.identityCorrection?.corrected || meta.ocrStudent || {}; %>
    <section class="card mb-3 revaluation-student-information" aria-labelledby="correctIdentityTitle">
      <div class="card-header d-flex align-items-center justify-content-between gap-2" id="correctIdentityTitle">
        <span>Student Information</span>
        <span class="d-flex gap-2"><span class="badge bg-secondary">Attempt <%= meta.attemptNo %></span><span class="badge bg-info text-dark"><%= meta.examType %></span></span>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-5"><label for="reviewIdentityUsn" class="form-label">USN <span class="text-danger" aria-hidden="true">*</span></label><input id="reviewIdentityUsn" name="usn" class="form-control" value="<%= identityValues.usn || '' %>" required maxlength="50" <%= mode === 'edit' ? '' : 'readonly' %>><div class="invalid-feedback">Enter the USN shown on the original card.</div></div>
          <div class="col-sm-7"><label for="reviewIdentityName" class="form-label">Student Name <span class="text-danger" aria-hidden="true">*</span></label><input id="reviewIdentityName" name="name" class="form-control" value="<%= identityValues.name || '' %>" required maxlength="150" <%= mode === 'edit' ? '' : 'readonly' %>><div class="invalid-feedback">Enter the registered student name shown on the original card.</div></div>
          <div class="col-12"><label for="revaluationAttemptNo" class="form-label">Attempt No <span class="text-danger" aria-hidden="true">*</span></label><input id="revaluationAttemptNo" class="form-control" value="<%= meta.attemptNo %>" readonly aria-readonly="true"></div>
        </div>
      </div>
    </section>
    <div class="card revaluation-subject-results">
      <div class="card-header d-flex align-items-center justify-content-between gap-2"><span>Subject Results</span><span class="small"><%= rows.length %> subjects</span></div>
      <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle mb-0" id="reviewTable">
          <thead class="table-light">
            <tr>
              <th style="width:90px;">Code</th>
              <th style="min-width:180px;">Subject</th>
              <th class="text-start">Original<br>(total)</th>
              <th style="width:90px;" class="text-center">Internal</th>
              <th style="width:90px;" class="text-center">Rev. Ext</th>
              <th style="width:80px;" class="text-center">Combined total</th>
              <th style="width:110px;" class="text-center">Decision</th>
            </tr>
          </thead>
          <tbody>
<%
  const ACK_LETTERS = ['ABSENT', 'WITHHELD', 'NOT_ELIGIBLE', 'A', 'W', 'X', 'NE'];
  const propBySrid = {};
  if (review && Array.isArray(review.proposal)) {
    review.proposal.forEach(p => { propBySrid[p.subject_result_id] = p; });
  }
  const editable = (mode === 'edit');
  const codeOfSrid = {};
  rows.forEach(r => { codeOfSrid[r.srid] = r.code; });
%>
<% rows.forEach(r => { const ev = r.evidence; %>
<%
  const entered = (enteredVals && enteredVals[r.srid]) || null;
  // PROMPT 14: pre-fill from server-side preferred values (prior proposal > OCR).
  // The controller already orders these in r.evidence.revised_int/ext; if a prior
  // frozen proposal exists for this target, it wins.
  const hasPrefill = (ev.revised_int !== null && ev.revised_int !== undefined)
                  || (ev.revised_ext !== null && ev.revised_ext !== undefined);
  const preInt = entered ? entered.internal
    : ((ev.revised_int !== null && ev.revised_int !== undefined) ? String(ev.revised_int) : '');
  const preExt = entered ? entered.external
    : ((ev.revised_ext !== null && ev.revised_ext !== undefined) ? String(ev.revised_ext) : '');
  // Extracted subjects start accepted; manual additions start rejected.
  // Re-editing always retains the saved decision.
  const defAccept = entered?.decision ? entered.decision === 'accept' : r.priorDecision
    ? r.priorDecision === 'accept'
    : ev.match_state === 'MATCHED' && !ev.manual_entry;
  const needAck = !!ev.raw_letter &&
    ACK_LETTERS.indexOf(String(ev.raw_letter).trim().toUpperCase()) !== -1;
  const rowErrs = (errors && errors[r.srid]) ? errors[r.srid] : [];
  const prop = propBySrid[r.srid] || null;
%>
            <tr data-max-marks="<%= r.maxMarks %>" class="<%= prop && prop.decision === 'reject' ? 'table-light text-muted' : '' %>">
              <td class="revaluation-subject-code"><code><%= r.code %></code></td>
              <td>
                <span class="revaluation-subject-name"><%= r.name %></span>
                <% if (ev.manual_entry || ev.manual_candidate) { %><small class="d-block revaluation-manual-label">Not detected by OCR &middot; Accept to enter marks from the card</small><% } %>
                <details class="mt-1" <%= editable && ev.ambiguous && r.pickOptions.length ? '' : 'hidden' %>><summary>OCR evidence</summary>
                <span class="badge bg-<%= ev.match_state === 'MATCHED' ? 'success' : (ev.match_state === 'AMBIGUOUS' ? 'warning text-dark' : 'secondary') %>">
                  <%= ev.match_state %>
                </span>
                <% if (ev.ocr_subject_code) { %>
                  <code><%= ev.ocr_subject_code %></code>
                  <small class="text-muted d-block">normalized: <%= ev.normalized || '—' %></small>
                  <% if (ev.raw_line) { %><small class="text-muted d-block" title="<%= ev.raw_line %>">raw line available</small><% } %>
                <% } else { %>
                  <small class="text-muted">not found on document</small>
                <% } %>
                <div class="mt-1">
                  <small>doc status:</small>
                  <% if (ev.raw_letter) { %>
                    <code><%= ev.raw_letter %></code>
                    <% if (ev.status_candidate) { %><span class="badge bg-info text-dark"><%= ev.status_candidate %></span><% } else { %><span class="badge bg-dark">unmapped</span><% } %>
                  <% } else { %><span class="text-muted">—</span><% } %>
                  <% if (ev.confidence) { %><span class="badge bg-secondary ms-1"><%= ev.confidence %></span><% } %>
                </div>
                <% if (editable && ev.ambiguous && r.pickOptions.length) { %>
                  <div class="mt-1">
                    <label class="form-label small mb-0" for="pick_<%= r.srid %>">Bind this doc row to:</label>
                    <select id="pick_<%= r.srid %>" name="ambiguous_pick_<%= r.srid %>" class="form-select form-select-sm" aria-describedby="pick_<%= r.srid %>_feedback">
                      <option value="">— choose subject —</option>
                      <% r.pickOptions.forEach(o => { %>
                        <option value="<%= o.id %>" <%= (entered && entered.pick === String(o.id)) ? 'selected' : '' %>>
                          <%= o.code %> (#<%= o.id %>)
                        </option>
                      <% }) %>
                    </select>
                    <div class="invalid-feedback" id="pick_<%= r.srid %>_feedback">Choose the original subject for this accepted document row.</div>
                  </div>
                <% } %>
                </details>
              </td>
              <td class="text-start">
                <span class="fw-bold"><%= r.origMarks !== null ? r.origMarks : '—' %></span><br>
                <span class="badge bg-<%= r.origStatus === 'pass' ? 'success' : 'danger' %>"><%= r.origStatus || '—' %></span>
                <% if (r.origGrade) { %><small class="text-muted d-block"><%= r.origGrade %></small><% } %>
              </td>

<% if (!editable && prop) { %>
              <td class="text-center">
                <span class="fw-bold"><%= prop.decision === 'accept' ? prop.proposed_revised_internal_marks : '—' %></span>
              </td>
              <td class="text-center">
                <span class="fw-bold"><%= prop.decision === 'accept' ? prop.proposed_revised_external_marks : '—' %></span>
              </td>
              <td class="text-center">
                <% if (prop.decision === 'accept') { %>
                  <span class="fw-bold text-primary"><%= prop.proposed_revised_total_marks %></span><br>
                  <span class="badge bg-<%= prop.proposed_revised_status === 'pass' ? 'success' : 'danger' %>"><%= prop.proposed_revised_status %></span>
                  <small><%= prop.proposed_revised_grade %></small>
                  <% if (prop.was_manual_correction) { %><small class="text-muted d-block">manually corrected</small><% } %>
                  <% if (prop.bound_to_srid && Number(prop.bound_to_srid) !== r.srid) { %>
                    <small class="text-muted d-block">bound to #<%= prop.bound_to_srid %></small>
                  <% } %>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
<% } else { %>
              <td class="text-center">
                <input type="number" min="0" max="<%= r.maxInternal %>" step="1"
                       name="internal_<%= r.srid %>" id="int_<%= r.srid %>" aria-label="Internal marks for <%= r.code %>"
                       value="<%= preInt %>" class="form-control form-control-sm rev-int"
                       data-srid="<%= r.srid %>" aria-describedby="int_<%= r.srid %>_feedback"
                       <%= editable && defAccept ? '' : 'disabled' %>>
                <div class="invalid-feedback" id="int_<%= r.srid %>_feedback">Enter whole-number internal marks from 0 to <%= r.maxInternal %>.</div>
              </td>
              <td class="text-center">
                <input type="number" min="0" max="<%= r.maxExternal %>" step="1"
                       name="external_<%= r.srid %>" id="ext_<%= r.srid %>" aria-label="Revised external marks for <%= r.code %>"
                       value="<%= preExt %>" class="form-control form-control-sm rev-ext"
                       data-srid="<%= r.srid %>" aria-describedby="ext_<%= r.srid %>_feedback" <%= editable && defAccept ? '' : 'disabled' %>>
                <div class="invalid-feedback" id="ext_<%= r.srid %>_feedback">Enter whole-number revised external marks from 0 to <%= r.maxExternal %>.</div>
              </td>
              <td class="text-center">
                <span id="tot_<%= r.srid %>" class="fw-bold text-primary">—</span>
                <small class="text-muted d-block">auto int+ext</small>
              </td>
<% } %>
              <td class="text-center">
                <% if (editable) { %>
                  <div class="form-check">
                    <input class="form-check-input rev-decision" type="radio"
                           name="decision_<%= r.srid %>" value="accept" data-srid="<%= r.srid %>" id="accept_<%= r.srid %>"
                           <%= defAccept ? 'checked' : '' %>>
                    <label class="form-check-label small" for="accept_<%= r.srid %>">Accept</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input rev-decision" type="radio"
                           name="decision_<%= r.srid %>" value="reject" data-srid="<%= r.srid %>" id="reject_<%= r.srid %>"
                           <%= defAccept ? '' : 'checked' %>>
                    <label class="form-check-label small" for="reject_<%= r.srid %>">Reject</label>
                  </div>
                  <% if (needAck) { %>
                    <div class="form-check mt-1 text-start">
                      <input class="form-check-input" type="checkbox" name="ack_<%= r.srid %>" id="ack_<%= r.srid %>" value="on"
                             aria-describedby="ack_<%= r.srid %>_feedback"
                             <%= (entered && entered.ack) ? 'checked' : '' %>>
                      <label class="form-check-label small text-wrap" for="ack_<%= r.srid %>" style="max-width:150px;">
                        I acknowledge the unrepresentable document letter
                      </label>
                      <div class="invalid-feedback" id="ack_<%= r.srid %>_feedback">Confirm the document status for this accepted subject.</div>
                    </div>
                  <% } %>
                <%# In locked/confirm mode: prop === null means the frozen proposal
                    entry was not found by srid — but r.priorDecision was already
                    populated from that same prior proposal during loadReviewState,
                    so it is the correct authoritative decision for this row. %>
                <% } else if (!prop) { %>
                  <% if (r.priorDecision) { %>
                    <span class="badge bg-<%= r.priorDecision === 'accept' ? 'primary' : 'secondary' %>">
                      <%= r.priorDecision.toUpperCase() %>
                    </span>
                  <% } else { %>
                    <span class="text-muted small">no decision saved</span>
                  <% } %>
                <% } else { %>
                  <% if (prop.decision === 'accept') { %>
                    <span class="badge bg-primary">ACCEPT</span>
                  <% } else { %>
                    <span class="badge bg-secondary">REJECTED</span>
                    <small class="d-block text-muted">no event will be created</small>
                  <% } %>
                <% } %>
                <% if (rowErrs.length) { %>
                  <div class="text-danger small mt-1 text-start">
                    <% rowErrs.forEach(e => { %><div><%= e %></div><% }) %>
                  </div>
                <% } %>
              </td>
            </tr>
<% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (mode === 'edit') { %>
      <div class="d-flex gap-2 mb-4 result-action-row">
        <button type="submit" id="validateRevaluationBtn" class="btn btn-primary" <%= previewIdentityBlocked ? 'disabled' : '' %>>
          <i class="material-icons align-middle me-1" aria-hidden="true">fact_check</i>Validate
        </button>
        <a href="/revaluation/<%= meta.resultId %>/upload?replace=1" class="btn btn-outline-secondary">Replace document</a>
      </div>
    <% } %>
  </form>
  </div>

  <% if (mode !== 'edit' && review) { %>
    <div class="card mb-3 border-success">
      <div class="card-header">Validated decisions snapshot
        <small class="text-muted">(saved <%= review.submitted_at || '' %> by admin #<%= review.submitted_by || '—' %>)</small></div>
      <div class="card-body">
        <% if (review.aggregate_preview) { %>
          <p class="mb-1"><strong>Derived effective preview:</strong>
            overall <%= review.aggregate_preview.overall_result %> &middot;
            SGPA <%= formatGpa(review.aggregate_preview.sgpa) %> &middot;
            CGPA <%= formatGpa(review.aggregate_preview.cgpa) %> &middot;
            failed <%= review.aggregate_preview.failed_subject_count %>
            <small class="text-muted">(display analytics — Result rows are never written)</small></p>
        <% } %>
        <p class="mb-3">Approval saves the accepted revaluation results. Original marks remain unchanged.</p>
        <div class="d-flex gap-2 result-action-row">
          <form method="POST" action="/revaluation/approve/<%= meta.importId %>" id="approveRevaluationForm">
            <input type="hidden" name="review_token" value="<%= meta.reviewToken || '' %>">
            <button type="submit" class="btn btn-success">
              <i class="material-icons align-middle me-1" aria-hidden="true">task_alt</i>Approve &amp; Save
            </button>
          </form>
          <a href="/revaluation/review/<%= meta.importId %>?edit=1" class="btn btn-outline-secondary">Edit decisions</a>
        </div>
      </div>
    </div>
  <% } %>

  <details class="mb-3 revaluation-ocr-evidence">
    <summary class="py-2">Raw extracted text</summary>
    <pre class="small text-muted" style="max-height:360px; overflow:auto;"><%= meta.rawText || 'No extracted text.' %></pre>
  </details>

  <div class="mt-2 mb-4 d-flex gap-2 flex-wrap">
    <% if (meta.examSessionId) { %>
      <a href="/revaluation/start/students?exam_session_id=<%= meta.examSessionId %>" class="btn btn-outline-secondary btn-sm">
        <i class="material-icons">arrow_back</i> Back to Students
      </a>
    <% } %>
    <a href="/revaluation/start" class="btn btn-outline-secondary btn-sm">
      <i class="material-icons">arrow_back</i> Back to result selection
    </a>
  </div>
</div>
<script src="/js/revaluation-review.js?v=20261025-5"></script>
