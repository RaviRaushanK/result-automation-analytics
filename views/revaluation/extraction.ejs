<div class="container-fluid revaluation-ui">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h4 class="mb-1"><i class="material-icons me-1">document_scanner</i> Revaluation — OCR Extraction</h4>
      <p class="text-muted mb-0">Candidates read from the uploaded revaluation document. Nothing academic has been changed.</p>
    </div>
    <div class="col-auto">
      <% if (extractionStatus === 'extracted') { %>
        <span class="badge bg-success">EXTRACTED</span>
      <% } else if (extractionStatus === 'failed') { %>
        <span class="badge bg-danger">FAILED</span>
      <% } else { %>
        <span class="badge bg-secondary"><%= logStatus || 'PENDING' %></span>
      <% } %>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (extractionStatus === 'failed') { %>
    <div class="alert alert-danger">
      <strong>Extraction failed<%= failedReason ? ' (' + failedReason + ')' : '' %>.</strong>
      <% if (errorMsg) { %><div class="small mt-1"><%= errorMsg %></div><% } %>
      You may retry below. No academic records were created or modified.
    </div>
  <% } %>

  <div class="card mb-3">
    <div class="card-header">Server-authoritative context (from the database)</div>
    <div class="card-body">
      <p class="mb-1"><strong>Import ID:</strong> <%= importId %> &middot; <strong>Result ID:</strong> <%= resultId !== null && resultId !== undefined ? resultId : '—' %></p>
      <p class="mb-1"><strong>Student:</strong> <%= serverStudent.student_name || student.name || '—' %> (<%= serverStudent.usn || student.usn || '—' %>)</p>
      <p class="mb-1"><strong>Session:</strong> <%= sessionDisplay || '—' %></p>
      <p class="mb-0"><strong>Attempt:</strong> #<%= attempt.attempt_no %> &middot; <span class="badge bg-info text-dark"><%= attempt.exam_type %></span></p>
    </div>
  </div>

  <% if (identityCheck) { %>
    <% if (identityCheck.severity === 'mismatch') { %>
      <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="material-icons mt-1" aria-hidden="true">warning</i>
        <div class="flex-grow-1">
          <div class="fw-bold mb-1">Student identity mismatch — confirmation required</div>
          <p class="mb-2">
            <strong>Selected student:</strong> <%= serverStudent.student_name || '—' %> (<%= serverStudent.usn || '—' %>)<br>
            <strong>On the marks card:</strong> <%= ocrStudent.name || '(not extracted)' %> (<%= ocrStudent.usn || '(not extracted)' %>)
          </p>
          <p class="mb-2 small"><%= identityCheck.message %></p>
          <% if (identityConfirmed) { %>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="badge bg-success"><i class="material-icons align-middle" style="font-size:14px;">check_circle</i> Mismatch acknowledged</span>
              <small class="text-muted">You may now proceed to review, or re-upload a corrected document below.</small>
            </div>
          <% } else { %>
            <div class="d-flex flex-wrap gap-2 mt-1">
              <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#confirmMismatchModal">
                <i class="material-icons align-middle" style="font-size:16px;">check_circle</i>
                Confirm mismatch and continue
              </button>
              <% if (resultId) { %>
                <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#reuploadFromMismatchModal">
                  <i class="material-icons align-middle" style="font-size:16px;">upload_file</i>
                  Re-upload Document
                </button>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    <% } else if (identityCheck.severity === 'warning') { %>
      <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
        <i class="material-icons mt-1" aria-hidden="true">info</i>
        <div>
          <div class="fw-bold mb-1">Identity check — minor difference</div>
          <p class="mb-0 small"><%= identityCheck.message %></p>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-success d-flex align-items-start gap-2" role="alert">
        <i class="material-icons mt-1" aria-hidden="true">verified</i>
        <div><span class="fw-bold">Identity verified.</span> <span class="small"><%= identityCheck.message %></span></div>
      </div>
    <% } %>
  <% } %>

  <div class="card mb-3">
    <div class="card-header">OCR identity evidence (candidates)</div>
    <div class="card-body">
      <p class="mb-1">
        <strong>OCR USN (raw):</strong> <code><%= ocrStudent.usn || '—' %></code>
        <% if (ocrStudent.usn) { %>
          <% if (ocrStudent.usn_matches_server) { %><span class="badge bg-success ms-1">matches</span><% } else { %><span class="badge bg-danger ms-1">MISMATCH</span><% } %>
        <% } %>
      </p>
      <% if (ocrStudent.usn_normalized && ocrStudent.usn_normalized !== ocrStudent.usn) { %>
        <p class="mb-1 small text-muted">
          <strong>OCR USN (normalized, I→1, O→0):</strong>
          <code><%= ocrStudent.usn_normalized %></code>
          <span class="ms-1" title="Used for server-identity comparison only. Not written to the Student record.">
            <i class="material-icons" style="font-size:14px;vertical-align:middle">compare_arrows</i>
          </span>
        </p>
      <% } %>
      <p class="mb-1">
        <strong>OCR name:</strong> <%= ocrStudent.name || '—' %>
        <% if (ocrStudent.name) { %>
          <% if (ocrStudent.name_matches_server) { %><span class="badge bg-success ms-1">matches</span><% } else { %><span class="badge bg-warning text-dark ms-1">differs</span><% } %>
        <% } %>
      </p>
      <p class="mb-1"><strong>Semester candidate:</strong> <%= semesterCandidate !== null && semesterCandidate !== undefined ? semesterCandidate : '—' %></p>
      <% const _aggPct = (function() {
           const c = confidenceScore;
           if (c === null || c === undefined) return '—';
           const n = Number(c);
           if (!Number.isFinite(n)) return '—';
           return Math.round(n * 100) + '%';
         })(); %>
      <p class="mb-0"><strong>Method:</strong> <%= extractionMethod || '—' %> &middot; <strong>Aggregate confidence:</strong> <%= _aggPct %> &middot; <strong>At:</strong> <%= extractedAt || '—' %></p>
    </div>
  </div>

  <!--
    ARCHITECTURE (workflow correction — no pre-upload subject selection):

    subjects[] = OCR-detected rows from the uploaded revaluation card only.
    The Extraction page shows ONLY what was detected on the card.
    There is NO "Missing / Not Detected" section because there is no
    pre-upload subject selection to diff against.
    The Review/Edit page's "Add Subject" feature (on the next page) lets
    the admin manually add a subject row when OCR did not detect one.
  -->
  <% const hasDetected   = subjects && subjects.length > 0; %>
  <% const hasMatched    = hasDetected && subjects.some(s => s.match_state === 'MATCHED'); %>
  <% const hasUnmatched  = hasDetected && subjects.some(s => s.match_state === 'UNMATCHED_NOT_IN_RESULT'); %>

  <% if (hasDetected) { %>
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-1">
      <span>
        <i class="material-icons align-middle me-1">document_scanner</i>
        Subjects detected on the revaluation card
        <span class="badge bg-primary ms-1"><%= subjects.length %></span>
      </span>
      <div class="d-flex gap-2 flex-wrap">
        <% if (hasMatched) { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle">
            Matched: <%= subjects.filter(s => s.match_state === 'MATCHED').length %>
          </span>
        <% } %>
        <% if (hasUnmatched) { %>
          <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
            Not in result: <%= subjects.filter(s => s.match_state === 'UNMATCHED_NOT_IN_RESULT').length %>
          </span>
        <% } %>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered align-middle mb-0" id="detected-subjects-table">
        <thead class="table-light">
          <tr>
            <th class="text-nowrap">#</th>
            <th class="text-nowrap">Code</th>
            <th class="text-nowrap">Name</th>
            <th class="text-nowrap text-center">Internal</th>
            <th class="text-nowrap text-center">Old</th>
            <th class="text-nowrap text-center">Old Result</th>
            <th class="text-nowrap text-center">RV</th>
            <th class="text-nowrap text-center">RV Result</th>
            <th class="text-nowrap text-center">Final</th>
            <th class="text-nowrap text-center">Final Result</th>
            <th class="text-nowrap text-center">Conf.</th>
            <th class="text-nowrap">Match</th>
          </tr>
        </thead>
        <tbody>
          <% subjects.forEach(function(s, idx) { %>
            <% const isMatched   = s.match_state === 'MATCHED'; %>
            <% const isUnmatched = s.match_state === 'UNMATCHED_NOT_IN_RESULT'; %>
            <% const confidence  = (s.confidence !== null && s.confidence !== undefined) ? s.confidence : null; %>
            <% const _confNum = (function() {
                 if (confidence === null || confidence === undefined) return null;
                 const n = Number(confidence);
                 if (!Number.isFinite(n)) return null;
                 return n;
               })();
               const _confPct = _confNum === null ? '—' : Math.round(_confNum * 100) + '%';
               // Map the canonical result letter to a badge color. The status
               // was normalized upstream to P / F / ABSENT / NE / X (or the raw
               // legacy 'pass' / 'fail' words for backward compatibility).
               const _resColor = function(r) {
                 if (!r) return 'secondary';
                 const u = String(r).toUpperCase();
                 if (u === 'P' || u === 'PASS') return 'success';
                 if (u === 'F' || u === 'FAIL' || u === 'ABSENT') return 'danger';
                 if (u === 'NE' || u === 'X') return 'warning text-dark';
                 return 'secondary';
               }; %>
            <% const rowClass    = isMatched ? '' : 'table-warning'; %>
            <tr class="<%= rowClass %>">
              <td class="text-muted"><%= idx + 1 %></td>
              <td><code class="small"><%= s.subjectCode || s.subject_code || s.ocr_subject_code || '—' %></code></td>
              <td><span class="small"><%= s.subjectName || s.subject_name || '—' %></span></td>
              <td class="text-center"><%= (s.internalMarks !== null && s.internalMarks !== undefined) ? s.internalMarks : '—' %></td>
              <td class="text-center"><%= (s.oldMarks !== null && s.oldMarks !== undefined) ? s.oldMarks : '—' %></td>
              <td class="text-center">
                <% if (s.oldResult) { %>
                  <span class="badge bg-<%= _resColor(s.oldResult) %>"><%= s.oldResult %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="text-center"><%= (s.rvMarks !== null && s.rvMarks !== undefined) ? s.rvMarks : '—' %></td>
              <td class="text-center">
                <% if (s.rvResult) { %>
                  <span class="badge bg-<%= _resColor(s.rvResult) %>"><%= s.rvResult %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="text-center fw-bold"><%= (s.finalMarks !== null && s.finalMarks !== undefined) ? s.finalMarks : '—' %></td>
              <td class="text-center">
                <% if (s.finalResult) { %>
                  <span class="badge bg-<%= _resColor(s.finalResult) %>"><%= s.finalResult %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (_confNum !== null) { %>
                  <span class="badge bg-secondary"><%= _confPct %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td>
                <% if (isMatched) { %>
                  <span class="badge bg-success">Matched</span>
                <% } else if (isUnmatched) { %>
                  <span class="badge bg-warning text-dark">Not In Result</span>
                <% } else { %>
                  <span class="badge bg-secondary"><%= s.match_state || '—' %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } else { %>
  <div class="card mb-3">
    <div class="card-header">Subjects detected on the revaluation card</div>
    <div class="card-body text-center text-muted py-4">
      <i class="material-icons" style="font-size:2rem">search_off</i>
      <p class="mb-0 mt-2">No subjects were detected on the revaluation card.</p>
    </div>
  </div>
  <% } %>

  <!--
    No "Missing / Not Detected" section here.
    There is no pre-upload subject selection in the current workflow.
    The next page (Review/Edit) exposes the student's full subject list
    via its existing "Add Subject" feature for admin manual entry.
  -->

  <div class="row">
    <div class="col-lg-6">
      <div class="card mb-3">
        <div class="card-header">Unmatched OCR subject codes</div>
        <div class="card-body">
          <% if (!unmatched.length) { %>
            <p class="text-muted mb-0">None — every document subject row was accounted for.</p>
          <% } else { %>
            <ul class="mb-0">
              <% unmatched.forEach(u => { %>
                <li><code><%= u.ocr_subject_code %></code> <%= u.revised_marks !== null && u.revised_marks !== undefined ? '— total candidate: ' + u.revised_marks : '' %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header">Warnings</div>
        <div class="card-body">
          <% if (!warnings.length) { %>
            <p class="text-success mb-0">No warnings.</p>
          <% } else { %>
            <ul class="mb-0">
              <% warnings.forEach(w => { %><li><%= w %></li><% }) %>
            </ul>
          <% } %>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header">Uploaded document</div>
        <div class="card-body">
          <p class="mb-1"><strong>File:</strong> <%= docName || '—' %></p>
          <% if (docLink) { %>
            <a href="<%= docLink %>" target="_blank" class="btn btn-sm btn-outline-secondary">
              <i class="material-icons align-middle me-1" style="font-size:16px;">picture_as_pdf</i>View original document
            </a>
          <% } else { %>
            <span class="text-muted small">No stored document link available.</span>
          <% } %>
        </div>
      </div>

      <% if (extractionStatus === 'failed') { %>
        <form method="POST" action="/revaluation/pending/<%= importId %>/extract" class="mb-3">
          <button type="submit" class="btn btn-warning"><i class="material-icons align-middle me-1" style="font-size:18px;">refresh</i>Retry OCR Extraction</button>
        </form>
      <% } %>
    </div>

    <div class="col-lg-6">
      <div class="card mb-3">
        <div class="card-header">Raw extracted text</div>
        <div class="card-body">
          <details>
            <summary class="text-primary">Show raw text (<%= rawText.length %> chars)</summary>
            <pre class="small text-muted mb-0" style="white-space:pre-wrap; max-height:420px; overflow:auto;"><%= rawText || '—' %></pre>
          </details>
        </div>
      </div>
    </div>
  </div>

  <div class="alert alert-warning mt-2">
    <i class="material-icons align-middle me-1">warning_amber</i>
    <strong>These are OCR candidates only. No marks have been changed. Review/Edit &amp; validation is the next stage.</strong>
  </div>

  <div class="mt-2 mb-4 d-flex gap-2 flex-wrap">
    <% if (logStatus === 'extracted' && extractionStatus === 'extracted' && !identityBlocking) { %>
      <a href="/revaluation/review/<%= importId %>" class="btn btn-primary btn-sm">
        <i class="material-icons align-middle">fact_check</i> Proceed to Review &amp; Validate
      </a>
    <% } else if (identityBlocking) { %>
      <button type="button" class="btn btn-primary btn-sm" disabled
              title="Confirm the student identity mismatch above before proceeding.">
        <i class="material-icons align-middle">block</i> Proceed to Review &amp; Validate
      </button>
    <% } %>
    <a href="/revaluation/pending/<%= importId %>" class="btn btn-outline-secondary btn-sm"><i class="material-icons">arrow_back</i> Back to pending record</a>
    <% if (sessionId) { %>
      <a href="/revaluation/start/students?session=<%= sessionId %>" class="btn btn-outline-secondary btn-sm"><i class="material-icons">arrow_back</i> Back to Students</a>
    <% } %>
    <% if (resultId) { %>
      <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#reuploadFromNavModal">
        <i class="material-icons">upload_file</i> Re-upload Document
      </button>
    <% } %>
    <a href="/revaluation/upload" class="btn btn-outline-secondary btn-sm"><i class="material-icons">arrow_back</i> Back to result selection</a>
  </div>
</div>

<!-- =============================================================
     Custom Bootstrap modals (replace ugly native browser dialogs)
     ============================================================= -->

<!-- Modal 1: Confirm identity mismatch -->
<div class="modal fade" id="confirmMismatchModal" tabindex="-1" aria-labelledby="confirmMismatchModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="POST" action="/revaluation/pending/<%= importId %>/confirm-identity" id="confirmMismatchForm">
        <div class="modal-header bg-warning-subtle">
          <h5 class="modal-title" id="confirmMismatchModalLabel">
            <i class="material-icons align-middle">warning_amber</i> Confirm student identity mismatch
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>The marks card you uploaded does not match the selected student. The OCR read:</p>
          <ul class="mb-2">
            <li><strong>Name on card:</strong> <%= ocrStudent.name || '(not extracted)' %></li>
            <li><strong>USN on card:</strong> <%= ocrStudent.usn || '(not extracted)' %></li>
          </ul>
          <p>While the selected student is:</p>
          <ul class="mb-2">
            <li><strong>Name:</strong> <%= serverStudent.student_name || '—' %></li>
            <li><strong>USN:</strong> <%= serverStudent.usn || '—' %></li>
          </ul>
          <p class="text-muted small mb-0">This confirmation applies only to the current extraction and is required before you can proceed to the review stage.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">
            <i class="material-icons align-middle" style="font-size:16px;">check_circle</i>
            Yes, confirm mismatch
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal 2: Re-upload from mismatch alert (small) -->
<div class="modal fade" id="reuploadFromMismatchModal" tabindex="-1" aria-labelledby="reuploadFromMismatchModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning-subtle">
        <h5 class="modal-title" id="reuploadFromMismatchModalLabel">
          <i class="material-icons align-middle">upload_file</i> Re-upload marks card
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Discard the current OCR extraction and re-upload a corrected marks card for this student?</p>
        <p class="text-muted small mb-0">The previous ImportLog record and uploaded file will be removed before the new document is registered.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <a href="/revaluation/<%= resultId %>/upload?replace=1" class="btn btn-warning">
          <i class="material-icons align-middle" style="font-size:16px;">upload_file</i>
          Re-upload now
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Modal 3: Re-upload from bottom nav (richer context) -->
<div class="modal fade" id="reuploadFromNavModal" tabindex="-1" aria-labelledby="reuploadFromNavModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning-subtle">
        <h5 class="modal-title" id="reuploadFromNavModalLabel">
          <i class="material-icons align-middle">upload_file</i> Re-upload the revaluation document
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>You are about to upload a new marks card for this student. The previous document and its OCR data will be discarded.</p>
        <div class="alert alert-info small mb-0">
          <strong>What happens next:</strong>
          <ol class="mb-0 ps-3">
            <li>Current ImportLog &amp; OcrExtraction are deleted (only if not yet approved).</li>
            <li>The previous uploaded file is removed from disk.</li>
            <li>Your new PDF is registered and a fresh OCR pass runs on it.</li>
            <li>You return to the extraction page to verify the new OCR output.</li>
          </ol>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <a href="/revaluation/<%= resultId %>/upload?replace=1" class="btn btn-warning">
          <i class="material-icons align-middle" style="font-size:16px;">upload_file</i>
          Continue to re-upload
        </a>
      </div>
    </div>
  </div>
</div>


