<div class="container-fluid">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h4 class="mb-1"><i class="material-icons me-1">person_search</i> Revaluation — Step 2: Select Student</h4>
      <p class="text-muted mb-0">Students who have results in session <strong><%= session.display %></strong>.</p>
    </div>
    <div class="col-auto">
      <a href="/revaluation/start" class="btn btn-outline-secondary btn-sm">Back to sessions</a>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <form class="row g-2 mb-3" method="get" action="/revaluation/start/students">
    <input type="hidden" name="session" value="<%= session.id %>">
    <div class="col-auto">
      <div class="input-group">
        <span class="input-group-text"><i class="material-icons">search</i></span>
        <input type="text" name="q" value="<%= query %>" class="form-control" placeholder="Search by USN or student name">
      </div>
    </div>
    <div class="col-auto d-flex align-items-end">
      <button type="submit" class="btn btn-primary">Filter</button>
    </div>
  </form>

  <% if (!students.length) { %>
    <div class="alert alert-info mb-0">No students with results in this session were found.</div>
  <% } else { %>
    <div class="list-group">
      <% students.forEach(st => { %>
        <a href="/revaluation/start/attempts?session=<%= session.id %>&student=<%= st.student_id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
          <span>
            <i class="material-icons align-middle me-2 text-primary">person</i> <%= st.student_name %>
            <span class="text-muted ms-2"><%= st.usn %></span>
          </span>
          <span class="badge bg-secondary">Select student</span>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>