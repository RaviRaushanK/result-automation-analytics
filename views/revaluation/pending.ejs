<div class="container-fluid revaluation-ui">
  <h4 class="mb-2">Revaluation extraction</h4>
  <p class="text-muted"><%= student.name || 'Student' %> &middot; <%= student.usn || '' %><br><%= sessionDisplay %></p>
  <div class="alert <%= typeof errorTitle !== 'undefined' && errorTitle ? 'alert-danger' : 'alert-warning' %>" role="alert">
    <strong><%= typeof errorTitle !== 'undefined' && errorTitle ? errorTitle : 'Preview not ready' %></strong>
    <% if (typeof errorTitle !== 'undefined' && errorTitle) { %>
      <% String(error).split('\n\n').forEach(paragraph => { %><p class="mt-2 mb-0"><%= paragraph %></p><% }); %>
    <% } else { %><p class="mb-0"><%= error || 'Extraction has not completed. Retry using the uploaded document or replace it.' %></p><% } %>
  </div>
  <% const doc = documents && documents[0]; %>
  <div class="mb-3">
    <strong>Document:</strong> <%= doc && doc.file_name || file_name %>
    <% if (doc && doc.file_url) { %>
      <a href="<%= doc.file_url %>" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm ms-2">
        <i class="material-icons" aria-hidden="true">open_in_new</i> Open
      </a>
    <% } %>
  </div>
  <div class="d-flex gap-2 result-action-row">
    <form method="POST" action="/revaluation/pending/<%= importId %>/extract">
      <button type="submit" class="btn btn-primary"><i class="material-icons" aria-hidden="true">refresh</i>Retry extraction</button>
    </form>
    <% if (typeof resultId !== 'undefined' && resultId) { %>
      <a href="/revaluation/<%= resultId %>/upload?replace=1" class="btn btn-outline-secondary">Replace document</a>
    <% } %>
    <a href="/revaluation/start" class="btn btn-outline-secondary">Back to result selection</a>
  </div>
</div>
