<div class="container-fluid revaluation-ui">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h4 class="mb-1">Upload Revaluation Document</h4>
      <p class="text-muted mb-0">
        <%= student.name %> (<%= student.usn %>) &middot;
        <%= sessionDisplay || '—' %> &middot;
        Attempt #<%= attempt.attempt_no %> &middot;
        <span class="badge bg-info text-dark"><%= attempt.exam_type %></span>
      </p>
    </div>
    <div class="col-auto d-flex align-items-start">
      <a href="/revaluation/start/attempts?session=<%= sessionId %>&student=<%= studentId %>" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (isReplace) { %>
    <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
      <i class="material-icons mt-1" aria-hidden="true">upload_file</i>
      <div>
        <strong>Re-uploading the marks card.</strong>
        The previous OCR extraction will be discarded and replaced with the new document you are about to upload.
        The new extracted preview will open after uploading.
      </div>
    </div>
  <% } %>

  <details class="mb-3">
    <summary class="py-2">Original subjects and marks (<%= subjectCount %>)</summary>
    <div class="table-responsive mb-0">
      <table class="table table-sm table-light align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Code</th><th>Subject</th><th class="text-end">Credits</th><th class="text-end">Original Marks</th><th>Grade</th><th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% subjects.forEach(s => {
            const passClass = s.result_status === 'pass' ? 'success' : 'danger'; %>
            <tr>
              <td><%= s.subject_code %></td>
              <td><%= s.subject_name %></td>
              <td class="text-end"><%= s.credits %></td>
              <td class="text-end"><%= s.original_marks %> / <%= s.max_marks || 100 %></td>
              <td><%= s.grade || '—' %></td>
              <td><span class="badge bg-<%= passClass %>"><%= s.result_status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </details>

  <form id="uploadForm" method="post" action="/revaluation/<%= resultId %>/upload" enctype="multipart/form-data">
    <div class="card mb-3">
      <div class="card-header">
        <i class="material-icons me-1">upload_file</i> Official revaluation document
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="revalidationDocument" class="form-label fw-semibold">Choose PDF file</label>
          <input class="form-control form-control-lg" type="file" id="revalidationDocument" name="revalidationDocument" accept="application/pdf" required>
          <div class="form-text">
            <span class="badge bg-light text-dark border me-1">PDF only</span>
            <span class="badge bg-light text-dark border me-1">Maximum 15 MB</span>
            The file is stored for the OCR revaluation stage and does not modify existing marks.
          </div>
        </div>
        <div id="selectedFile" class="alert alert-info d-none mb-3">
          <i class="material-icons align-middle me-1">description</i>
          <strong>Selected:</strong> <span id="selectedFileName"></span>
          <span class="text-muted small ms-2">(<span id="selectedFileSize"></span>)</span>
        </div>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2 result-action-row">
      <button type="submit" class="btn btn-success" id="submitUploadBtn" disabled>
        <i class="material-icons align-middle" aria-hidden="true">cloud_upload</i> Upload &amp; Preview
      </button>
      <a href="/revaluation/start/attempts?session=<%= sessionId %>&student=<%= studentId %>" class="btn btn-outline-secondary">Back</a>
    </div>
    <p id="uploadProgress" class="text-muted mt-3 d-none" role="status">Uploading and extracting the marks card...</p>
  </form>
</div>

<script>
(function() {
  var fileInput = document.getElementById('revalidationDocument');
  var submitBtn = document.getElementById('submitUploadBtn');
  var form = document.getElementById('uploadForm');
  var selectedFile = document.getElementById('selectedFile');
  var submitting = false;
  if (!fileInput || !submitBtn || !form) return;

  fileInput.addEventListener('change', function() {
    var file = fileInput.files && fileInput.files[0];
    var error = '';
    if (file && (!/\.pdf$/i.test(file.name) || (file.type && file.type !== 'application/pdf'))) {
      error = 'Choose a PDF document.';
    } else if (file && file.size > 15 * 1024 * 1024) {
      error = 'The PDF must be 15 MB or smaller.';
    }
    fileInput.setCustomValidity(error);
    submitBtn.disabled = !file || !!error;
    selectedFile.classList.toggle('d-none', !file);
    if (file) {
      document.getElementById('selectedFileName').textContent = file.name;
      document.getElementById('selectedFileSize').textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
    }
    if (error) fileInput.reportValidity();
  });

  form.addEventListener('submit', function(event) {
    if (submitting || !form.checkValidity()) {
      event.preventDefault();
      return;
    }
    submitting = true;
    submitBtn.disabled = true;
    form.setAttribute('aria-busy', 'true');
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Extracting...';
    document.getElementById('uploadProgress').classList.remove('d-none');
  });
  window.addEventListener('pageshow', function(event) {
    if (event.persisted) window.location.reload();
  });
})();
</script>
