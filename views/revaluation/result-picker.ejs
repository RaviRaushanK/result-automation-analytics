<div class="container-fluid">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h4 class="mb-1">Upload Revaluation</h4>
      <p class="text-muted mb-0">Find the original result whose subjects you want to send for revaluation.</p>
    </div>
    <div class="col-auto">
      <a href="/revaluation/upload" class="btn btn-outline-secondary btn-sm">Reset</a>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <form class="row g-2 mb-3" method="get" action="/revaluation/upload">
    <div class="col-auto">
      <div class="input-group">
        <span class="input-group-text"><i class="material-icons">search</i></span>
        <input type="text" name="q" value="<%= query %>" class="form-control" placeholder="Search by USN or student name">
      </div>
    </div>
    <div class="col-auto d-flex align-items-end">
      <button type="submit" class="btn btn-primary">Filter</button>
    </div>
  </form>

    <% if (!results.length) { %>
    <div class="alert alert-info mb-0">No results found<% const _q = query; %><%= _q ? (' for "' + _q + '". Try a different search.') : '.' %></div>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Student</th><th>USN</th><th>Session</th><th class="text-center">Attempt</th><th>Type</th><th class="text-center">Status</th><th class="text-end">Open</th>
        </tr>
      </thead>
      <tbody>
        <% results.forEach(r => {
          const passClass = r.result_status === 'pass' ? 'success' : 'danger'; %>
        <tr>
          <td><%= r.student_name %></td>
          <td><%= r.usn %></td>
          <td><%= r.semester %><br><small class="text-muted"><%= r.exam_session %> <%= r.exam_year %></small></td>
          <td class="text-center"><%= r.attempt_no %></td>
          <td><%= r.exam_type %></td>
          <td class="text-center"><span class="badge bg-<%= passClass %>"><%= r.result_status %></span></td>
          <td class="text-end"><a href="/revaluation/<%= r.result_id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="text-muted">Showing <%= results.length %> most recent results.</div>
  <% } %>
</div>
