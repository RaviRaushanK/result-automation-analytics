<section class="account-access-page" aria-labelledby="account-access-title">
  <div class="account-access-card">
    <a class="account-access-brand" href="/" aria-label="SRAAS home"><span class="material-icons" aria-hidden="true">bar_chart</span><span>SRAAS<small>Student Result Analysis System</small></span></a>
    <div class="account-access-icon" aria-hidden="true"><span class="material-icons">lock</span></div>
    <p class="account-access-eyebrow">Access restricted</p>
    <h1 id="account-access-title">Your access is currently disabled</h1>
    <p class="account-access-description">You can’t access SRAAS with this account. If you believe you should still have access, please contact your institution administrator.</p>
    <div class="account-access-guidance"><span class="material-icons" aria-hidden="true">info_outline</span><p>Your administrator can review your account status and restore access when appropriate.</p></div>
    <div class="account-access-actions">
      <a class="btn btn-primary" href="<%= signInHref %>"><span class="material-icons" aria-hidden="true">login</span>Return to sign in</a>
      <a class="account-access-home" href="/"><span class="material-icons" aria-hidden="true">arrow_back</span>Back to home</a>
    </div>
  </div>
</section>
