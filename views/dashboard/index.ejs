<% const canReviewResults = typeof user !== 'undefined' && ['admin', 'faculty'].includes(user.role); %>
<div class="container-fluid workspace-page dashboard-page" data-can-review="<%= canReviewResults %>">
    <!-- Page Header -->
    <div class="dashboard-header">
        <div>
            <h4>Dashboard</h4>
            <p class="text-muted">Student Result Analytics Overview</p>
        </div>
        <% if (canReviewResults) { %>
        <nav class="dashboard-shortcuts" aria-label="Academic reports">
            <a class="btn btn-outline-primary" href="/analytics/overview" data-dashboard-link="/analytics/overview"><span class="material-icons" aria-hidden="true">insights</span> Analytics</a>
            <a class="btn btn-outline-secondary" href="/reports/class" data-dashboard-link="/reports/class"><span class="material-icons" aria-hidden="true">description</span> Class Report</a>
        </nav>
        <% } %>
    </div>

    <!-- Filter Section -->
    <div class="card filter-card">
        <div class="card-body">
            <form id="dashboardFilterForm" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="filterBatch" class="form-label">Batch</label>
                    <%# No "All Batches" option: dashboard.js lists batches newest-first and selects the latest. %>
                    <select id="filterBatch" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label for="filterSemester" class="form-label">Semester</label>
                    <select id="filterSemester" class="form-select">
                        <option value="">All Semesters</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="filter-actions">
                        <button type="button" id="applyFilterBtn" class="btn btn-primary">
                            <span class="material-icons btn-icon">refresh</span>
                            Refresh
                        </button>
                        <button type="button" id="resetFilterBtn" class="btn btn-outline-secondary">
                            <span class="material-icons btn-icon">refresh</span>
                            Reset
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="dashboard-context"><span id="dashboardScope">Original results &middot; All attempts</span><span id="dashboardUpdated" role="status" aria-live="polite"></span></div>
    <div id="dashboardError" class="alert alert-danger d-none" role="alert"></div>
    <div id="dashboardEmpty" class="alert alert-info d-none" role="status">No imported results for this selection.</div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">

        <div class="col-sm-6 col-xl-3">
            <!-- Total Students -->
            <div class="card stat-card stat-blue">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">group</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalStudents">--</div>
                        <div class="stat-label">Students with Results</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <!-- Total Pass -->
            <div class="card stat-card stat-green">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">check_circle</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalPass">--</div>
                        <div class="stat-label">Passed Attempts</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <!-- Total Fail -->
            <div class="card stat-card stat-red">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">cancel</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalFail">--</div>
                        <div class="stat-label">Failed Attempts</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <!-- Pass % -->
            <div class="card stat-card stat-teal">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">trending_up</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="passPercentage">--</div>
                        <div class="stat-label">Pass %</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fail % -->
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card stat-amber">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">trending_down</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="failPercentage">--</div>
                        <div class="stat-label">Fail %</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Subjects -->
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card stat-purple">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">menu_book</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalSubjects">--</div>
                        <div class="stat-label">Total Subjects</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Highest Score -->
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card stat-orange">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">emoji_events</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="highestScore">--</div>
                        <div class="stat-label">Highest Subject Mark</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Average CGPA -->
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card stat-emerald">
                <span class="stat-corner" aria-hidden="true"></span>
                <div class="card-body">
                    <div class="stat-icon">
                        <span class="material-icons">school</span>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" id="averageCGPA">--</div>
                        <div class="stat-label">Average Stored CGPA</div>
                    </div>
                </div>
            </div>
        </div>
        
    </div>

    <!-- Top 10 Scorers -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-baseline flex-wrap gap-1">
            <h5 class="card-title mb-0">Top 10 Scorers</h5>
            <small class="text-muted">Passing attempts with stored CGPA. Legacy GPA is not certified cumulative GPA.</small>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle top-scorers-table mb-0" id="topScorersTable">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">USN</th>
                            <th scope="col">Student Name</th>
                            <th scope="col">SGPA</th>
                            <th scope="col">CGPA</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center table-loading">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <span class="ms-2 text-muted">Loading top scorers...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4 dashboard-chart-grid">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header dashboard-chart-heading">
                    <h5 class="card-title mb-0">Subject Wise Average Marks</h5>
                    <select id="subjectChartOrder" class="form-select form-select-sm" aria-label="Sort subjects">
                        <option value="average">Highest average</option><option value="failures">Most failures</option><option value="code">Subject code</option>
                    </select>
                </div>
                <div class="card-body">
                    <div id="subjectAverageMessage" class="alert alert-warning py-2 mb-2 d-none"></div>
                    <div class="chart-container chart-scroll-container">
                        <div class="chart-scroll">
                            <div class="chart-scroll-inner" id="subjectAverageChartWrap">
                                <canvas id="subjectAverageChart" role="img" aria-label="Average original marks by subject"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">Pass vs Fail Analysis</h5>
                </div>
                <div class="card-body">
                    <div id="passFailEmpty" class="dashboard-chart-empty" hidden>No result attempts available.</div>
                    <div class="chart-container" id="passFailChartWrap"><canvas id="passFailPieChart" role="img" aria-label="Passed and failed original result attempts"></canvas></div>
                    <div class="dashboard-result-counts"><span>Passed <strong id="chartPassedCount">0</strong></span><span>Failed <strong id="chartFailedCount">0</strong></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4 mt-1 dashboard-chart-grid">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header dashboard-chart-heading"><h5 class="card-title mb-0">Grade Distribution</h5><small class="text-muted">Stored subject grades</small></div>
                <div class="card-body">
                    <div id="gradeEmpty" class="dashboard-chart-empty" hidden>No subject grades available for this selection.</div>
                    <div class="chart-container" id="gradeChartArea"><canvas id="gradeDistributionChart" role="img" aria-label="Number of original subject attempts in each stored grade"></canvas></div>
                    <div class="dashboard-result-counts"><span>Graded <strong id="gradedAttemptCount">--</strong></span><span>Not recorded <strong id="missingGradeCount">--</strong></span></div>
                    <details class="dashboard-grade-details mt-3"><summary>Grade Breakdown</summary><div class="table-responsive mt-2"><table class="table table-sm mb-0"><thead><tr><th>Grade</th><th>Attempts</th><th>Share</th></tr></thead><tbody id="gradeBreakdownBody"></tbody></table></div></details>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header dashboard-chart-heading"><h5 class="card-title mb-0">Subjects to Review</h5><small class="text-muted">Original failed subject attempts</small></div>
                <div class="card-body">
                    <div class="table-responsive" tabindex="0" role="region" aria-label="Subjects with failed attempts"><table class="table align-middle mb-0 dashboard-attention-table"><thead><tr><th>Subject</th><th>Failed / Attempts</th><th>Pass %</th></tr></thead><tbody id="dashboardAttentionBody"><tr><td colspan="3" class="text-muted">Loading...</td></tr></tbody></table></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Expose filter data to dashboard.js -->
<div id="dashboardFilters"
     data-batches="<%= JSON.stringify(batches || []) %>"
     data-semesters="<%= JSON.stringify(semesters || []) %>"
     data-batch-semesters="<%= JSON.stringify(typeof batchSemesters !== 'undefined' ? batchSemesters : null) %>"
     class="d-none"></div>
<script src="/js/reports/chart.umd.min.js"></script>
<script src="/js/dashboard.js?v=20261016-2"></script>
