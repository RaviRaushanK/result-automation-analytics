<% const registrationIsBlocked = typeof registrationBlocked !== 'undefined' && registrationBlocked; %>
<div class="container-fluid result-management-page result-review-page">
      <% if (typeof warnings !== 'undefined' && warnings.length) { %>
      <div class="alert alert-warning" role="alert">
        <% warnings.forEach(function (warning) { %><div><%= warning %></div><% }); %>
      </div>
      <% } %>
      <% if (typeof extractionWarning !== 'undefined' && extractionWarning) { %>
      <div class="alert alert-warning extraction-alert d-flex align-items-start mb-3" role="alert" id="extractionAlert">
        <i class="material-icons me-2 mt-1 flex-shrink-0">warning</i>
        <div>
          <strong>Extraction Incomplete</strong>
          <div class="small mt-1" id="extractionAlertMessage"><%= extractionWarning %></div>
        </div>
      </div>
      <% } %>

      <% if (typeof formError !== 'undefined' && formError) { %>
      <div class="alert alert-danger extraction-alert d-flex align-items-start mb-3" role="alert" id="resultValidationAlert">
        <i class="material-icons me-2 mt-1 flex-shrink-0">error</i>
        <div><strong>Validation Failed</strong><div class="small mt-1"><%= formError %></div></div>
      </div>
      <% } %>

  <header class="result-review-header">
    <div><h4 class="mb-1">Review &amp; Edit</h4><div class="small text-muted"><%= sessionDisplay %></div></div>
    <div class="result-review-header-actions">
      <span class="badge bg-secondary-subtle text-secondary">Step 2 of 4</span>
      <% if (typeof user !== 'undefined' && user?.role === 'admin') { %>
      <a class="btn btn-sm btn-outline-secondary" href="/subjects?tab=roster"><i class="material-icons" aria-hidden="true">fact_check</i> Semester roster</a>
      <% } %>
    </div>
  </header>
          <% if (typeof duplicateStudent !== 'undefined' && duplicateStudent) { %>
            <div class="alert alert-danger d-flex align-items-start" role="alert">
              <i class="material-icons me-2 mt-1">block</i>
              <div>
                <strong>Duplicate Student Detected</strong>
                <div class="small mt-1">
                  A result for <strong><%= student.usn %></strong> already exists in this session
                  (<%= sessionDisplay %>) for attempt <%= attempt.attempt_no %> (<%= attempt.exam_type %>).
                  You cannot save another result for the same student and attempt.
                </div>
              </div>
            </div>
          <% } %>

  <%- include('partials/import-scope') %>
  <form action="/results/upload/<%= importId %>/validate" method="POST" id="reviewForm" data-registration-blocked="<%= registrationIsBlocked %>" novalidate>
    <div class="alert alert-info">
      <label><input type="checkbox" name="verify_document_context" value="1"> I verified the displayed student, academic semester, examination period and attempt against the original document, including any details OCR could not identify.</label>
      <% if (typeof excludedSubjects !== 'undefined' && excludedSubjects.length) { %><div><label><input type="checkbox" name="verify_mixed_context" value="1"> This is a mixed document. I verified that only the courses for the selected academic semester/attempt are included; the displayed excluded rows belong to a separate upload.</label></div><% } %>
    </div>
    <div class="result-review-layout">
      <section class="result-document result-review-document" aria-labelledby="reviewDocumentTitle">
        <div class="result-review-section-heading">
          <h6 id="reviewDocumentTitle" class="mb-0">Original Marks Card</h6>
          <a href="<%= fileUrl %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><i class="material-icons" aria-hidden="true">open_in_new</i> Open</a>
        </div>
        <div class="result-review-document-body">
          <% if (fileType === 'pdf') { %>
            <iframe src="<%= fileUrl %>" title="Original marks card" class="result-document-frame"></iframe>
          <% } else { %>
            <img src="<%= fileUrl %>" alt="Original marks card" class="result-review-document-image">
          <% } %>
        </div>
      </section>
      <div class="result-review-editor">
        <section class="result-review-student" aria-labelledby="reviewStudentTitle">
          <div class="result-review-section-heading">
            <h6 id="reviewStudentTitle" class="mb-0">Student Information</h6>
            <div class="d-flex flex-wrap gap-2"><span class="badge bg-secondary">Attempt <%= attempt.attempt_no %></span><span class="badge bg-info text-dark"><%= attempt.exam_type %></span></div>
          </div>
                    <div class="row g-3">
                      <div class="col-md-5">
                        <label class="form-label small fw-semibold" for="usnInput">
                          USN <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control text-uppercase <%= (typeof errors !== 'undefined' && errors['student.usn']) ? 'is-invalid' : '' %>"
                               id="usnInput"
                               name="usn"
                               value="<%= student.usn %>"
                               maxlength="20"
                               required
                               placeholder="e.g. 1MV25MC001"
                               autocomplete="off">
                        <% if (typeof errors !== 'undefined' && errors['student.usn']) { %>
                          <div class="field-error-message text-danger small mt-1"><%= errors['student.usn'] %></div>
                        <% } %>
                      </div>
                      <div class="col-md-7">
                        <label class="form-label small fw-semibold" for="studentNameInput">
                          Student Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control <%= (typeof errors !== 'undefined' && errors['student.name']) ? 'is-invalid' : '' %>"
                               id="studentNameInput"
                               <%- (typeof errors !== 'undefined' && errors['student.name']) ? 'data-server-invalid="true" aria-invalid="true"' : '' %>
                               name="name"
                               value="<%= student.name %>"
                               maxlength="100"
                               required
                               placeholder="Full name as on marks card"
                               autocomplete="off">
                        <% if (typeof errors !== 'undefined' && errors['student.name']) { %>
                          <div class="field-error-message text-danger small mt-1" data-server-rendered="true"><%= errors['student.name'] %></div>
                        <% } %>
                      </div>
                    </div>
                    <!-- Attempt edits are checked against semester history on
                         validation and checked again at final import. -->
                    <div class="mb-3">
                      <label for="reviewAttemptNo" class="form-label fw-semibold">Attempt No <span class="text-danger">*</span></label>
                      <input type="number" class="form-control" id="reviewAttemptNo" name="attempt_no" value="<%= attempt.attempt_no %>" min="<%= attempt.exam_type === 'REGULAR' ? 1 : 2 %>" step="1" required <%= attempt.exam_type === 'REGULAR' ? 'readonly' : '' %>>
                      <div class="form-text">For this student and semester: Regular 1, Backlog 2, 3 and onward across exam sessions.</div>
                    </div>
                    <input type="hidden" name="exam_type" value="<%= attempt.exam_type %>">

        </section>
        <section class="result-review-subjects" aria-labelledby="reviewSubjectsTitle">
          <div class="result-review-section-heading"><h6 id="reviewSubjectsTitle" class="mb-0">Subject Results</h6><span class="small text-muted"><%= subjects.length %> subjects</span></div>
          <div class="table-responsive result-review-table-scroll" role="region" aria-label="Subject marks" tabindex="0">
            <table class="table table-bordered align-middle mb-0" id="subjectsTable">
              <colgroup><col class="review-code-column"><col class="review-subject-column"><col class="review-marks-column"><col class="review-marks-column"><col class="review-total-column"><col class="review-status-column"></colgroup>
              <thead class="table-light"><tr><th scope="col">Code</th><th scope="col">Subject</th><th scope="col" class="text-center">Internal</th><th scope="col" class="text-center">External</th><th scope="col" class="text-center">Total</th><th scope="col" class="text-center">Status</th></tr></thead>
              <tbody>
                          <% subjects.forEach(function (s) { %>
                            <% var maxI = s.max_internal ?? 50; %>
                            <% var maxE = s.max_external ?? 100; %>
                            <% var maxM = s.max_marks || (maxI + maxE); %>
                            <% var iVal = (s.internalMarks != null && s.internalMarks !== "") ? s.internalMarks : ""; %>
                            <% var xVal = (s.externalMarks != null && s.externalMarks !== "") ? s.externalMarks : ""; %>
                            <% var total = (iVal !== "" && xVal !== "") ? (parseInt(iVal,10) + parseInt(xVal,10)) : ""; %>
                            <% var sid = String(s.subject_id); %>
                            <% var rowErrors = (typeof errors !== 'undefined' && errors['subjects[' + sid + ']']) ? errors['subjects[' + sid + ']'] : null; %>
                            <tr data-max-marks="<%= maxM %>" data-max-internal="<%= maxI %>" data-max-external="<%= maxE %>" data-subject-id="<%= sid %>" class="<%= rowErrors ? 'table-danger' : '' %>">
                              <td><code><%= s.subject_code %></code></td>
                              <td class="review-subject"><%= s.subject_name %></td>
                              <td>
                                <input type="number"
                                       min="0"
                                       max="<%= maxI %>"
                                       class="form-control form-control-sm internal-input <%= rowErrors && rowErrors.internalMarks ? 'is-invalid' : '' %>"
                                       id="internal_<%= sid %>"
                                       name="internal_<%= sid %>"
                                       value="<%= iVal %>"
                                       <%= attempt.exam_type === 'REGULAR' ? 'required' : '' %>
                                       placeholder="0-<%= maxI %>" aria-label="<%= s.subject_code %> internal marks" aria-describedby="internalLimit_<%= sid %>">
                                <div class="small text-muted" id="internalLimit_<%= sid %>">max <%= maxI %></div>
                                <% if (rowErrors && rowErrors.internalMarks) { %>
                                  <div class="field-error-message text-danger small mt-1"><%= rowErrors.internalMarks %></div>
                                <% } %>
                              </td>
                              <td>
                                <input type="number"
                                       min="0"
                                       max="<%= maxE %>"
                                       class="form-control form-control-sm external-input <%= rowErrors && rowErrors.externalMarks ? 'is-invalid' : '' %>"
                                       id="external_<%= sid %>"
                                       name="external_<%= sid %>"
                                       value="<%= xVal %>"
                                       <%= attempt.exam_type === 'REGULAR' ? 'required' : '' %>
                                       placeholder="0-<%= maxE %>" aria-label="<%= s.subject_code %> external marks" aria-describedby="externalLimit_<%= sid %>">
                                <div class="small text-muted" id="externalLimit_<%= sid %>">max <%= maxE %></div>
                                <% if (rowErrors && rowErrors.externalMarks) { %>
                                  <div class="field-error-message text-danger small mt-1"><%= rowErrors.externalMarks %></div>
                                <% } %>
                              </td>
                              <td class="fw-bold total-cell"><%= total !== "" ? total : "—" %></td>
                              <td class="status-cell text-center"><% if (total !== "") { %><% var pct = Math.floor((total/maxM)*100); %><% if (pct >= 50) { %><span class="badge bg-success">PASS</span><% } else { %><span class="badge bg-danger">FAIL</span><% } %><% } else { %><span class="badge bg-secondary">N/A</span><% } %></td>
                            </tr>
                          <% }); %>

              </tbody>
            </table>
          </div>
        </section>
        <footer class="result-review-actions">
          <div class="result-review-action-buttons">
            <a href="/results/upload" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" id="validateButton" class="btn btn-primary" <%= registrationIsBlocked || (typeof duplicateStudent !== 'undefined' && duplicateStudent) ? 'disabled' : '' %> <%- registrationIsBlocked ? 'aria-describedby="studentRegistrationHint"' : '' %>>
              Validate <i class="material-icons" aria-hidden="true">arrow_forward</i>
            </button>
          </div>
          <% if (registrationIsBlocked) { %><p id="studentRegistrationHint" class="small text-danger mt-2 mb-0">Correct the USN to validate again, or register or restore this student in the selected batch, then refresh Review to enable validation.</p><% } %>
        </footer>
      </div>
    </div>
  </form>
</div>
<script src="/js/results/review.js?v=20261016-1"></script>
