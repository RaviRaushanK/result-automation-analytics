<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-12">

      <% if (typeof extractionWarning !== 'undefined' && extractionWarning) { %>
      <div class="alert alert-warning extraction-alert d-flex align-items-start mb-3" role="alert" id="extractionAlert">
        <i class="material-icons me-2 mt-1 flex-shrink-0">warning</i>
        <div>
          <strong>Extraction Incomplete</strong>
          <div class="small mt-1" id="extractionAlertMessage"><%= extractionWarning %></div>
        </div>
      </div>
      <% } %>

      <% if (typeof formError !== 'undefined' && formError) { %>
      <div class="alert alert-danger extraction-alert d-flex align-items-start mb-3" role="alert">
        <i class="material-icons me-2 mt-1 flex-shrink-0">error</i>
        <div><strong>Validation Failed</strong><div class="small mt-1"><%= formError %></div></div>
      </div>
      <% } %>

      <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <h4 class="mb-0">Review & Edit</h4>
            <small class="text-muted"><%= sessionDisplay %></small>
          </div>
          <span class="badge bg-warning text-dark">Step 2 of 4 &mdash; compare the card, fix any OCR mistakes</span>
        </div>
        <div class="card-body">
          <% if (typeof duplicateStudent !== 'undefined' && duplicateStudent) { %>
            <div class="alert alert-danger d-flex align-items-start" role="alert">
              <i class="material-icons me-2 mt-1">block</i>
              <div>
                <strong>Duplicate Student Detected</strong>
                <div class="small mt-1">
                  A result for <strong><%= student.usn %></strong> already exists in this session
                  (<%= sessionDisplay %>) for attempt <%= attempt.attempt_no %> (<%= attempt.exam_type %>).
                  You cannot save another result for the same student and attempt.
                </div>
              </div>
            </div>
          <% } %>
          <form action="/results/upload/<%= importId %>/validate" method="POST" id="reviewForm" novalidate>
            <div class="row g-3">
              <!-- LEFT: original marks card -->
              <div class="col-lg-6">
                <div class="border rounded bg-light h-100 d-flex flex-column" style="min-height: 480px;">
                  <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-white rounded-top">
                    <strong>Original Marks Card</strong>
                    <a href="<%= fileUrl %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                      <i class="material-icons" style="font-size:16px;">open_in_new</i> Open
                    </a>
                  </div>
                  <div class="flex-grow-1 overflow-auto p-2">
                    <% if (fileType === 'pdf') { %>
                      <iframe src="<%= fileUrl %>" style="width:100%; height:759px; border:none;"></iframe>  <!-- Updated 560px to 759px -->
                    <% } else { %>
                      <img src="<%= fileUrl %>" alt="Original marks card" class="img-fluid rounded mx-auto d-block" style="max-height:640px;">
                    <% } %>
                  </div>
                </div>
              </div><!-- /LEFT -->
              
              <!-- RIGHT: editable extracted data -->
              <div class="col-lg-6">
                <div class="card mb-3">
                  <div class="card-body">
                    <h6 class="text-primary mb-3">Student Information</h6>
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                      <span class="badge bg-secondary">Attempt <%= attempt.attempt_no %></span>
                      <span class="badge bg-info text-dark"><%= attempt.exam_type %></span>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-5">
                        <label class="form-label small fw-semibold" for="usnInput">
                          USN <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control text-uppercase <%= (typeof errors !== 'undefined' && errors['student.usn']) ? 'is-invalid' : '' %>"
                               id="usnInput"
                               name="usn"
                               value="<%= student.usn %>"
                               maxlength="20"
                               required
                               placeholder="e.g. 1MV25MC001"
                               autocomplete="off">
                        <% if (typeof errors !== 'undefined' && errors['student.usn']) { %>
                          <div class="field-error-message text-danger small mt-1"><%= errors['student.usn'] %></div>
                        <% } %>
                      </div>
                      <div class="col-md-7">
                        <label class="form-label small fw-semibold" for="studentNameInput">
                          Student Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control <%= (typeof errors !== 'undefined' && errors['student.name']) ? 'is-invalid' : '' %>"
                               id="studentNameInput"
                               name="name"
                               value="<%= student.name %>"
                               maxlength="100"
                               required
                               placeholder="Full name as on marks card"
                               autocomplete="off">
                        <% if (typeof errors !== 'undefined' && errors['student.name']) { %>
                          <div class="field-error-message text-danger small mt-1"><%= errors['student.name'] %></div>
                        <% } %>
                      </div>
                    </div>
                    <!-- Hidden manner: attempt authority round-trips through validate;
                         it is re-sanitized server-side, never trusted at import. -->
                    <input type="hidden" name="attempt_no" value="<%= attempt.attempt_no %>">
                    <input type="hidden" name="exam_type" value="<%= attempt.exam_type %>">
                  </div>
                </div>
                <div class="card">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <h6 class="text-primary">Subject Results</h6>
                      <span class="badge bg-secondary small"><%= subjects.length %> subjects</span>
                    </div>
                    <div class="table-responsive">
                      <table class="table table-bordered table-striped align-middle mb-0" id="subjectsTable">
                        <thead class="table-light"><tr>
                          <th style="width:10%;">Code</th><th style="width:35%;">Subject</th>
                          <th class="text-center" style="width:15%;">Internal</th>
                          <th class="text-center" style="width:15%;">External</th>
                          <th class="text-center">Total</th><th class="text-center">Status</th>
                        </tr></thead>
                        <tbody>
                          <% subjects.forEach(function (s) { %>
                            <% var maxI = s.max_internal || 50; %>
                            <% var maxE = s.max_external || 100; %>
                            <% var maxM = s.max_marks || (maxI + maxE); %>
                            <% var iVal = (s.internalMarks != null && s.internalMarks !== "") ? s.internalMarks : ""; %>
                            <% var xVal = (s.externalMarks != null && s.externalMarks !== "") ? s.externalMarks : ""; %>
                            <% var total = (iVal !== "" && xVal !== "") ? (parseInt(iVal,10) + parseInt(xVal,10)) : ""; %>
                            <% var sid = String(s.subject_id); %>
                            <% var rowErrors = (typeof errors !== 'undefined' && errors['subjects[' + sid + ']']) ? errors['subjects[' + sid + ']'] : null; %>
                            <tr data-max-marks="<%= maxM %>" data-max-internal="<%= maxI %>" data-max-external="<%= maxE %>" data-subject-id="<%= sid %>" class="<%= rowErrors ? 'table-danger' : '' %>">
                              <td><code><%= s.subject_code %></code></td>
                              <td><%= s.subject_name %></td>
                              <td>
                                <input type="number"
                                       min="0"
                                       max="<%= maxI %>"
                                       class="form-control form-control-sm internal-input <%= rowErrors && rowErrors.internalMarks ? 'is-invalid' : '' %>"
                                       id="internal_<%= sid %>"
                                       name="internal_<%= sid %>"
                                       value="<%= iVal %>"
                                       required
                                       placeholder="0-<%= maxI %>">
                                <div class="small text-muted">max <%= maxI %></div>
                                <% if (rowErrors && rowErrors.internalMarks) { %>
                                  <div class="field-error-message text-danger small mt-1"><%= rowErrors.internalMarks %></div>
                                <% } %>
                              </td>
                              <td>
                                <input type="number"
                                       min="0"
                                       max="<%= maxE %>"
                                       class="form-control form-control-sm external-input <%= rowErrors && rowErrors.externalMarks ? 'is-invalid' : '' %>"
                                       id="external_<%= sid %>"
                                       name="external_<%= sid %>"
                                       value="<%= xVal %>"
                                       required
                                       placeholder="0-<%= maxE %>">
                                <div class="small text-muted">max <%= maxE %></div>
                                <% if (rowErrors && rowErrors.externalMarks) { %>
                                  <div class="field-error-message text-danger small mt-1"><%= rowErrors.externalMarks %></div>
                                <% } %>
                              </td>
                              <td class="fw-bold total-cell"><%= total !== "" ? total : "—" %></td>
                              <td class="status-cell text-center"><% if (total !== "") { %><% var pct = Math.floor((total/maxM)*100); %><% if (pct >= 50) { %><span class="badge bg-success">PASS</span><% } else { %><span class="badge bg-danger">FAIL</span><% } %><% } else { %><span class="badge bg-secondary">N/A</span><% } %></td>
                            </tr>
                          <% }); %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                  <a href="/results/upload" class="btn btn-outline-secondary flex-fill">Cancel</a>
                  <button type="submit" id="validateButton" class="btn btn-primary btn-lg flex-fill<%= (typeof duplicateStudent !== 'undefined' && duplicateStudent) ? " disabled" : "" %>">
                    Validate <i class="material-icons align-middle ms-1" style="font-size:18px;">arrow_forward</i>
                  </button>
                </div>
              </div><!-- /RIGHT -->
            </div><!-- /row -->
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/results/review.js"></script>
