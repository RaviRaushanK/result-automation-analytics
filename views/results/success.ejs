<% const confirmed = typeof savedConfirmed === 'undefined' || savedConfirmed;
const resultStatus = String(overallResult || '').toLowerCase();
const gpa = value => value === null || value === undefined || value === '' || !Number.isFinite(Number(value)) ? 'Unavailable' : Number(value).toFixed(2); %>
<section class="import-success-page" aria-labelledby="importSuccessTitle">
  <header class="import-success-header">
    <% if (confirmed) { %><div class="import-celebration" aria-hidden="true"><% for (let i = 0; i < 36; i++) { %><span style="--x:<%= (i * 73) % 600 - 300 %>px;--rise:<%= -60 - (i * 41) % 130 %>px;--spin:<%= (i * 137) % 720 - 360 %>deg;--delay:<%= (i % 9) * 35 %>ms;--piece:<%= ['#16a36b','#2875ed','#e7ae26','#dd538a','#28a9b0'][i % 5] %>"></span><% } %></div><% } %>
    <div class="import-success-mark <%= confirmed ? 'is-confirmed' : 'is-unavailable' %>" aria-hidden="true"><span class="material-icons"><%= confirmed ? 'check' : 'info' %></span></div>
    <div class="import-success-heading"><div class="import-success-eyebrow"><%= confirmed ? 'Import complete' : 'Import record' %></div><h1 id="importSuccessTitle"><%= confirmed ? 'Result imported successfully' : 'Saved result unavailable' %></h1><p><%= confirmed ? 'Saved and ready for your academic reports.' : 'No saved result was found for this import. Review the import log before trying again.' %></p></div>
    <% if (confirmed) { %><button type="button" class="import-celebration-replay" id="replayImportCelebration" title="Replay celebration" aria-label="Replay celebration"><span class="material-icons" aria-hidden="true">celebration</span></button><% } %>
  </header>
  <div class="import-student-overview"><span class="material-icons" aria-hidden="true">person</span><div><div class="import-success-student"><%= studentName || 'Unavailable' %></div><div class="import-success-usn"><%= usn %></div></div></div>
  <dl class="import-success-details">
    <div><dt>Examination session</dt><dd><%= sessionDisplay %></dd></div>
    <div><dt>Attempt</dt><dd><%= attemptNo %><span class="import-success-tag"><%= examType %></span></dd></div>
    <div><dt>Subjects imported</dt><dd><%= subjectsCount %></dd></div>
  </dl>
  <div class="import-success-metrics">
    <div><div class="import-success-label">Result</div><div class="import-success-value <%= resultStatus === 'pass' ? 'is-pass' : resultStatus === 'fail' ? 'is-fail' : '' %>"><%= resultStatus === 'pass' ? 'PASS' : resultStatus === 'fail' ? 'FAIL' : 'Unavailable' %></div></div>
    <div><div class="import-success-label">Stored SGPA</div><div class="import-success-value"><%= gpa(sgpa) %></div><p>Saved semester grade point average</p></div>
    <div><div class="import-success-label">Cumulative CGPA</div><div class="import-success-value"><%= gpa(typeof cgpa === 'undefined' ? null : cgpa) %></div><p><%= gpa(typeof cgpa === 'undefined' ? null : cgpa) === 'Unavailable' ? 'Complete verified course and grading history is required.' : 'Saved cumulative grade point average' %></p></div>
  </div>
  <nav class="import-success-actions" aria-label="Import actions">
    <a href="/results/upload" class="btn btn-primary"><span class="material-icons" aria-hidden="true">cloud_upload</span>Upload Another</a>
    <a href="/results/logs" class="btn btn-outline-secondary"><span class="material-icons" aria-hidden="true">list_alt</span>View Import Logs</a>
  </nav>
</section>
<script src="/js/results/success.js" defer></script>
