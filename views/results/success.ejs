<% const confirmed = typeof savedConfirmed === 'undefined' || savedConfirmed;
const resultStatus = String(overallResult || '').toLowerCase();
const gpa = value => formatGpa(value, 'Unavailable');
const backlogWithoutSgpa = String(examType || '').toUpperCase() === 'BACKLOG' && gpa(sgpa) === 'Unavailable'; %>
<section class="import-success-page result-management-page" aria-labelledby="importSuccessTitle">
  <%- include('partials/success-header', { confirmed, headingId: 'importSuccessTitle', eyebrow: confirmed ? 'Import complete' : 'Import record', heading: confirmed ? 'Result imported successfully' : 'Saved result unavailable', description: confirmed ? 'Saved and ready for your academic reports.' : 'No saved result was found for this import. Review the import log before trying again.' }) %>
  <div class="import-student-overview"><span class="material-icons" aria-hidden="true">person</span><div><div class="import-success-student"><%= studentName || 'Unavailable' %></div><div class="import-success-usn"><%= usn %></div></div></div>
  <dl class="import-success-details">
    <div><dt>Examination session</dt><dd><%= sessionDisplay %></dd></div>
    <div><dt>Attempt</dt><dd><%= attemptNo %><span class="import-success-tag"><%= examType %></span></dd></div>
    <div><dt>Subjects imported</dt><dd><%= subjectsCount %></dd></div>
  </dl>
  <div class="import-success-metrics">
    <div><div class="import-success-label">Result</div><div class="import-success-value <%= resultStatus === 'pass' ? 'is-pass' : resultStatus === 'fail' ? 'is-fail' : '' %>"><%= resultStatus === 'pass' ? 'PASS' : resultStatus === 'fail' ? 'FAIL' : 'Unavailable' %></div></div>
    <div><div class="import-success-label">Stored SGPA</div><div class="import-success-value"><%= backlogWithoutSgpa ? 'Not applicable' : gpa(sgpa) %></div><p><%= backlogWithoutSgpa ? 'SGPA is not calculated for a backlog attempt. The original Regular SGPA remains unchanged.' : 'Saved semester grade point average' %></p></div>
    <div><div class="import-success-label">Cumulative CGPA</div><div class="import-success-value"><%= gpa(typeof cgpa === 'undefined' ? null : cgpa) %></div><p><%= gpa(typeof cgpa === 'undefined' ? null : cgpa) === 'Unavailable' ? 'Complete verified course and grading history is required.' : 'Saved cumulative grade point average' %></p></div>
  </div>
  <nav class="import-success-actions" aria-label="Import actions">
    <a href="/results/upload?batch_id=<%= batchId %>&exam_session_id=<%= examSessionId %>&attempt_no=<%= attemptNo %>&exam_type=<%= examType %>" class="btn btn-primary"><span class="material-icons" aria-hidden="true">cloud_upload</span>Upload Another</a>
    <a href="/results/logs" class="btn btn-outline-secondary"><span class="material-icons" aria-hidden="true">list_alt</span>View Import Logs</a>
  </nav>
</section>
<script src="/js/results/success.js" defer></script>
