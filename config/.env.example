# Copy to config/.env for a new installation; do not overwrite existing credentials.
# Process environment values take precedence over this file.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=academic_result_analytics_db

# Use production only when deployed behind HTTPS with the appropriate proxy setup.
NODE_ENV=development
# Replace with a long, random private value; never use this placeholder in production.
SESSION_SECRET=replace_with_a_long_random_session_secret

# Application and emailed invitation links
APP_PORT=3000
# Local testing only. For other devices, set the reachable application origin.
# Keep the port consistent with APP_PORT; do not include a path, query or fragment.
APP_BASE_URL=http://localhost:3000

# Email: invitations, registration, email changes and password recovery.
# Real SMTP delivery is required. Phone registration and SMS verification are retired.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
# For Gmail, use an App Password belonging to SMTP_USER.
SMTP_PASS=your_smtp_password
SMTP_FROM=SRAAS <no-reply@example.com>

# Optional hybrid extraction: OCR + vision + text-model reconciliation.
# Leave the key empty for local-only extraction. Meaningful embedded PDF tables
# may be read directly without an external provider call.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VLM_MODEL=qwen/qwen3.8-27b
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=60000

# auto: hybrid when configured, otherwise local OCR. Hybrid failures fall back.
# vlm: currently uses the same hybrid/fallback branch as auto.
# tesseract: local extraction without the hybrid provider.
EXTRACTION_MODE=auto

# Rasterized-PDF limits and hybrid page-worker concurrency (1 or 2).
VLM_MAX_PAGES=3
VLM_RENDER_SCALE=2
VLM_PAGE_CONCURRENCY=2

# Upload limits and storage paths are defined by application code/configuration,
# not by environment variables. Restart the app after editing config/.env.
