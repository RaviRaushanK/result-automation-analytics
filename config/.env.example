DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=academic_result_analytics_db

SESSION_SECRET=your_session_secret  # e.g., "my_super_secret_key_2026" <- For Development
#For production, use a long random string Ex:"a7c4d3e1f9b8c2d7e6f5a4b3c1d9e8f7a6b5c4d3e2f1a9b8c7d6e5f4a3b2c1d0".


APP_PORT=3000
# Use the reachable application origin for emailed invitations in production.
APP_BASE_URL=http://localhost:3000
DEBUG_MODE=true
UPLOAD_PATH=./uploads/results
MAX_UPLOAD_SIZE=20MB
OCR_PROVIDER=tesseract

# ============================================================
# Email (SMTP) — used for OTP delivery
# ============================================================
# Real SMTP delivery is required for email verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=SRAAS <no-reply@example.com>

# ============================================================
# AI Hybrid Extraction (advanced OCR + VLM + LLM) — FREE via Groq
# ============================================================
# Get a free key at https://console.groq.com/keys
# When GROQ_API_KEY is set and EXTRACTION_MODE is not "tesseract", the
# extractor uses: advanced Tesseract OCR + a vision model + a text LLM.
# Without the key, the app silently falls back to classic Tesseract.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Vision model (reads the document images) and LLM (reconciles OCR+VLM).
GROQ_VLM_MODEL=qwen/qwen3.8-27b
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=60000

# Extraction mode: "auto" (use AI when key present, else Tesseract),
# "vlm" (force AI), or "tesseract" (always classic OCR).
EXTRACTION_MODE=auto

# VLM tuning: how many pages of a PDF to send (cost/latency guard) and the
# rasterisation scale for scanned PDFs (2 ≈ 144 DPI).
VLM_MAX_PAGES=3
VLM_RENDER_SCALE=2

